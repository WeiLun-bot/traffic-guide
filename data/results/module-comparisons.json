    "M1-03": {
      "title": "路側停車",
      "intro": "讓停車帶的起終點、進出操作空間與標誌資訊互相配合。",
      "items": [
        {
          "id": "boundary",
          "title": "清楚區分停車與禁停範圍",
          "text": "標誌位置與停車帶起終點一致，讓用路人容易搜尋、判讀及遵循。"
        },
        {
          "id": "clearance",
          "title": "保留進出端及轉角淨空",
          "text": "在漸變段、出入口與路口轉角保留必要空間，避免停車妨礙行車與視線。"
        },
        {
          "id": "operation",
          "title": "停放角度配合操作空間",
          "text": "依場地選擇停放角度，一起檢查可設車位數、進出軌跡與所需通道。"
        },
        {
          "id": "information",
          "title": "用標誌與附牌說明使用條件",
          "text": "整理停車用途、專用對象與限制資訊，避免牌面內容和現場格位不一致。"
        }
      ],
