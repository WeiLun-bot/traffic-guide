    "M3-04": {
      "title": "公車",
      "intro": "一起檢視專用道、進出端與站位，維持公車動線的連續與可辨識性。",
      "items": [
        {
          "id": "continuity",
          "title": "專用道與進出端連續銜接",
          "text": "整合路段、路口及站位周邊的導引，減少一般車流與路邊停車干擾。"
        },
        {
          "id": "trajectory",
          "title": "幾何配置配合公車軌跡",
