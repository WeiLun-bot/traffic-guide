  "modules": {
    "M1-01": {
      "title": "路口動線導引",
      "intro": "從路段車道配置到路口轉向，一起檢查行車動線是否連續。",
      "items": [
        {
          "id": "continuity",
          "title": "車道用途要前後連續",
          "text": "依路口轉向需求安排上游車道，避免駕駛到路口前才發現必須換道。"
        },
        {
          "id": "trajectory",
          "title": "導引線配合實際轉彎軌跡",
          "text": "檢核車輛軌跡與下游出口，讓車輛能循線轉彎，避免偏向交通島。"
        },
        {
          "id": "advance",
          "title": "在需要選道前提供提示",
          "text": "搭配指向線、車道預告標誌及穿越虛線，提前說明行向與車道變化。"
        },
        {
          "id": "transition",
          "title": "一併安排漸變與儲車空間",
          "text": "附加車道需兼顧漸變、停等長度及槽化，減少轉向車流干擾直行車流。"
        }
      ],
      "moduleId": "M1-01",
      "pageId": "results-module-m1-01",
      "images": [
