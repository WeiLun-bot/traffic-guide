    "M2-01": {
      "title": "停、讓管制",
      "intro": "先分清優先關係，再安排停等、觀察來車及行人穿越的位置。",
      "items": [
        {
          "id": "issue",
          "title": "讓駕駛明確知道誰先通行",
          "text": "由停車再開或讓路標誌預告管制，接近路口時再以標字與標線提示。"
        },
        {
          "id": "diagram",
          "title": "停等位置要能觀察主要道路",
          "text": "依視距與來車動線檢查停止線、讓路線位置，兼顧行人穿越及觀察需求。"
        },
        {
          "id": "extension",
          "title": "標誌、標線與幾何空間一起檢視",
          "text": "配合路口導引線、行穿線、庇護空間及路緣修飾，形成一致的停讓配置。"
        }
