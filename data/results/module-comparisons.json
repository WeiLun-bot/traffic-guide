    "M2-02": {
      "title": "圓環管制",
      "intro": "把環內優先、入口減速與環內導引，用一組一致的設施表達。",
      "items": [
        {
          "id": "priority",
          "title": "明確提示環內優先",
          "text": "以讓路標誌及讓路線提示進環車輛讓行，減少環內、環外車輛爭道。"
        },
        {
          "id": "entry",
          "title": "入口線型引導減速與偏移",
          "text": "分隔島、槽化與標線配合行車軌跡，讓駕駛提前辨識入口及偏移方向。"
        },
        {
          "id": "continuity",
          "title": "維持環內至出口的導引連續",
          "text": "串接環內車道與出口路徑，減少臨時換道、切入出口或不必要的減速。"
        },
        {
          "id": "walking",
          "title": "一起安排入口與出口的行人穿越",
          "text": "檢視行穿線、庇護空間與讓路位置，避免車流停等遮擋行人。"
        }
      ],
