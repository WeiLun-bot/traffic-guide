      "m101-lanes-issues": {
        "points": [
          {
            "id": "continuity",
            "title": "車道用途前後不連續",
            "titleKey": "m101-lanes-issues|module|continuity|title",
            "text": "原直行車道於路口前轉為左轉專用車道",
            "textKey": "m101-lanes-issues|module|continuity|text"
          },
          {
            "id": "review",
            "title": "路口上下游車道數不平衡",
            "titleKey": "m101-lanes-issues|module|review|title",
            "text": "上游直行車道數多於下游接收車道數，容易造成車輛於路口內搶道。",
            "textKey": "m101-lanes-issues|module|review|text"
          },
          {
            "id": "path",
            "title": "導引線、路緣轉角未依車輛軌跡設計",
            "titleKey": "m101-lanes-issues|module|path|title",
            "text": "未檢核車輛轉彎軌跡，可能造成車輛偏離導引路徑，擦撞交通島或路緣；路緣轉角若僅以直線截角處理，可能形成多餘車行空間，並增加行人穿越距離。",
            "textKey": "m101-lanes-issues|module|path|text"
          }
        ]
      },
      "m101-additional-issues": {
        "points": [
          {
            "id": "missing-lane",
            "title": "缺乏附加車道",
            "text": "原直行車道於路口前改為左轉車道，轉向車流未另設附加車道分流，影響直行動線的連續性。",
