  "texts": {
    "m303-turning-diagram|module|location|text": "於號誌管制且符合車道條件的路口設置兩段式左轉待轉區，待轉區應位於停止線前端，與枕木紋行人穿越道線間隔至少 50 cm，且不得侵入交叉口實際範圍。",
    "m303-turning-diagram|module|location|title": "配合停止線與行穿線安排待轉區",
    "m303-turning-diagram|module|upstream|text": "\n",
    "m303-turning-diagram|module|upstream|title": "\n"
  },
