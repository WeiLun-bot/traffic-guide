    "conditions": {
      "g404-conditions": {
        "issues": [
          {
            "id": "issue-original-0",
            "title": "行人穿越安全性不足",
            "titleKey": "g404-conditions:content:photo:g404-photo-1:title",
            "imageKey": "g404-photo-1",
            "photo": true,
            "points": [
              {
                "id": "issue-original-0-point-0",
                "text": "主要道路行人穿越距離長，無設置行人庇護島\n",
                "textKey": "g404-conditions:content:photo:g404-photo-1:point-0"
              }
            ]
          },
          {
            "id": "issue-original-1",
            "title": "主要道路車道銜接不一致",
            "titleKey": "g404-conditions:content:photo:g404-photo-2:title",
            "imageKey": "g404-photo-2",
            "photo": true,
            "points": [
              {
                "id": "issue-original-1-point-0",
                "text": "路口進出車道數不同，行車動線需要清楚引導。",
                "textKey": "g404-conditions:content:photo:g404-photo-2:point-0"
              }
            ]
          },
          {
            "id": "issue-original-2",
            "title": "速限資訊不明",
            "titleKey": "g404-conditions:content:photo:g404-photo-3:title",
            "imageKey": "g404-photo-3",
            "photo": true,
            "points": [
              {
                "id": "issue-original-2-point-0",
                "text": "主要道路僅部分方向有速限提示，次要道路則缺少速限標示。",
                "textKey": "g404-conditions:content:photo:g404-photo-3:point-0"
              }
            ]
          }
        ]
      }
    },
    "articles": {
      "g404-lane-warning": {
        "points": [
          {
            "id": "point-original-0",
            "text": "右側車道、路寬縮減標誌，設於同向多車道或路寬縮減路段鄰近處。",
            "textKey": "g404-lane-warning|1|text-6"
          },
          {
            "id": "point-original-1",
            "text": "§ 23 警告標誌設置位置與警告標的物起點之距離，應配合行車速率，自45–200 m為度，如受實際情形限制，得酌予變更。但其設置位置必須明顯，並不得少於安全停車視距。",
            "textKey": "g404-lane-warning|1|text-7"
          }
        ]
      },
      "g404-speed": {
        "points": [
          {
            "id": "point-original-0",
            "text": "快、慢車道速限不同且未設中央分隔島時，速限資訊須明確對應適用車道。以最高速限標誌加設附牌表示。",
            "textKey": "g404-speed|1|text-6"
          },
          {
            "id": "point-99425f74-9c3f-4c0f-bb12-b22ceeadf1fa",
            "text": "快車道速限在上；慢車道速限在下。",
            "textKey": "g404-speed|content|articles|point-99425f74-9c3f-4c0f-bb12-b22ceeadf1fa"
          },
          {
            "id": "point-2dd35d27-0906-48ed-b37c-31c6a2ffefa9",
            "text": "若涉有速限標字，則與標誌應相互配合。",
            "textKey": "g404-speed|content|articles|point-2dd35d27-0906-48ed-b37c-31c6a2ffefa9"
          }
        ]
      },
      "g404-privacy": {
        "points": [
          {
            "id": "point-original-0",
            "text": "當駕駛人有誤看其他燈號可能時，就需要對燈面處理，讓駕駛人只看得到屬於自己正確方向的燈面，因此建議燈面可以用特長筒式罩簷（民間俗稱「砲筒」），即可正確對應至管制的路段。",
            "textKey": "g404-privacy|1|text-6"
          }
        ]
      },
      "g404-near-highspeed": {
        "points": [
          {
            "id": "point-original-0",
            "text": "依設置規則§ 201 第2款規定：「行車管制號誌應使車輛駕駛人在距停止線之左表列距離前能同時辨認兩個以上顯示相同燈號之燈面。如因路況限制無法符合下表要求時，應於號誌將近之處輔設「注意號誌」標誌，或作速率限制。」",
            "textKey": "g404-near-highspeed|1|text-6"
          }
        ]
      }
    },
