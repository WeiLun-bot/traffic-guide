    "articles": {
      "g106-lane-line": {
        "points": [
          {
            "id": "point-original-0",
            "text": "本示例於距離路口前30–60 m範圍，取消佈設快慢車道分隔線，改佈設混合車道。",
            "textKey": "g106-lane-line|1|text-6"
          },
          {
            "id": "point-original-1",
            "text": "透過指向線引導、劃分直行或右轉方向，使用路人明確判斷其應選擇的車道位置。",
            "textKey": "g106-lane-line|1|text-7"
          }
        ]
      },
      "g106-crosswalk-line": {
        "points": [
          {
            "id": "point-original-0",
            "text": "如次要道路配合路側人行道有佈設行穿線之需求時，佈設方式。",
            "textKey": "g106-crosswalk-line|1|text-6"
          },
          {
            "id": "point-531a3337-3bc2-41ad-b0b0-0b0207f25f8d",
            "text": "因為斜交路口，可採調和角度的行穿線。",
            "textKey": "g106-crosswalk-line|content|articles|point-531a3337-3bc2-41ad-b0b0-0b0207f25f8d"
          },
          {
            "id": "point-original-1",
            "text": "如次要道路評估行人通行需求較低，則路口採不設置行穿線。",
            "textKey": "g106-crosswalk-line|1|text-7"
          }
        ]
      },
      "g106-yield-sign": {
        "points": [
          {
            "id": "point-original-0",
            "text": "本示例如於次要道路路口設置讓路線時，將配合設置讓路標誌「遵2」。",
            "textKey": "g106-yield-sign|1|text-6"
          }
        ]
      },
      "g106-speed-sign": {
        "points": [
          {
            "id": "point-original-0",
            "text": "於支線道路口處布設最高速限標誌，提示轉入支線駕駛人依速限行駛。",
            "textKey": "g106-speed-sign|1|text-6"
          },
          {
            "id": "point-82284545-6dee-4fc9-85f0-4871e765991d",
            "text": "標誌以布設於駕駛人面向之右側為原則，但由於本情境為斜交路口，考慮到幹道右轉轉入車輛之可視性，建議增設於左側。",
            "textKey": "g106-speed-sign|content|articles|point-82284545-6dee-4fc9-85f0-4871e765991d"
          }
        ]
      }
    },
