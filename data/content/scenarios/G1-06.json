{
  "schemaVersion": 1,
  "owner": "scenarios/G1-06",
  "texts": {
    "g106-context|0|text-12": "防止臨時轉向與交織",
    "g106-context|0|text-15": "盡可能將停等方向調整為接近垂直，減少斜交死角。",
    "g106-context|0|text-16": "交角與轉向空間併同考量，行穿線則依行人需求配置。",
    "g106-yield-sign|1|text-7": "\n",
    "g106-speed-sign|0|text-4": "加以提示支線道速限。",
    "g106-speed-sign|1|text-8": "\n",
    "g106-review|0|text-2": "轉向車提前選擇車道",
    "g106-review|0|text-1": "將次要道路交角調整，並在主線安排左轉與直右車道。",
    "g106-review|shared|title": "斜交路口的交角改善與轉向動線銜接。",
    "g106-review|0|text-7": "標誌位置、路面標字與導標共同考量。"
  },
