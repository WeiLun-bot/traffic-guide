    "articles": {
      "g302-channel": {
        "points": [
          {
            "id": "point-original-0",
            "text": "槽化線主要劃設於交岔路口、立體交岔之匝道口或其他特殊地點。故可做為高路口辨識性之用。",
            "textKey": "g302-channel|1|text-6"
          },
          {
            "id": "point-original-1",
            "text": "本示例於南北向主要道路鄰近路口處劃設槽化線，藉由槽化線用以引導車輛駕駛人循指示之路線行駛，若車輛偏移進入槽化區域，可透過槽化斜紋線方向導回原行駛動線。",
            "textKey": "g302-channel|1|text-7"
          }
        ]
      },
      "g302-junction-warning": {
        "points": [
          {
            "id": "point-original-0",
            "text": "主要道路上可設置岔路標誌「警11」，提醒駕駛人注意前方路口。",
            "textKey": "g302-junction-warning|1|text-6"
          }
        ]
      },
      "g302-edge": {
        "points": [
          {
            "id": "point-original-0",
            "text": "路面邊線用以指示路肩或路面外側邊緣之界線，其位置須配合道路中心線、車道數、車道寬度、中央分隔及路肩寬度配置。",
            "textKey": "g302-edge|1|text-6"
          },
          {
            "id": "point-original-1",
            "text": "路肩寬度屬市區道路範疇者，須符合《市區道路及附屬工程設計規範》§ 2.4之規定；屬公路範疇者，須符合《公路路線設計規範》§ 2.3之規定。",
            "textKey": "g302-edge|1|text-7"
          }
        ]
      }
    },
