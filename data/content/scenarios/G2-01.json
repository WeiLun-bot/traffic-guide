            "title": "速限不明確",
            "titleKey": "g201-conditions:content:photo:g201-photo-2:title",
            "imageKey": "g201-photo-2",
            "photo": true,
            "points": [
              {
                "id": "issue-original-1-point-0",
                "text": "主、次要道路無標字、標誌表示速限",
