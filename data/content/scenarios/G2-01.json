                "textKey": "g201-conditions|content|issue-original-1|point-2b40852e-0d85-4a61-aaac-cca0278c49a3"
              }
            ]
          },
          {
            "id": "issue-original-2",
            "title": "行人號誌不易直視",
            "titleKey": "g201-conditions:content:photo:g201-photo-3:title",
            "imageKey": "g201-photo-3",
            "photo": true,
            "points": [
              {
                "id": "issue-original-2-point-0",
                "text": "行穿線與行人號誌位置不易相互對照，行人判讀較困難。",
