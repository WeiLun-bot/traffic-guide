      "urban-merge-no-left": {
        "points": [
          {
            "id": "point-original-0",
            "text": "路口行駛方向有所限制時，應設置禁行方向標誌。",
            "textKey": "urban-merge-no-left|1|text-6"
          },
          {
            "id": "point-original-1",
            "text": "以設置於車行道右側為原則，得加設於左側。",
            "textKey": "urban-merge-no-left|1|text-7"
          },
          {
            "id": "point-1ba56fc1-c6e3-45a9-a952-d9bd4c473f3b",
            "text": "得改以起點形式為直行的道路遵行方向標誌設置。",
            "textKey": "urban-merge-no-left|content|articles|point-1ba56fc1-c6e3-45a9-a952-d9bd4c473f3b"
          }
        ]
      },
      "urban-merge-direction": {
        "points": [
          {
            "id": "point-original-0",
            "text": "路口行駛方向有所限制時，應設置遵行方向標誌。",
            "textKey": "urban-merge-direction|1|text-6"
          },
          {
            "id": "point-original-1",
            "text": "僅准左轉或僅准右轉設於遠端，其他起點形式為直行的道路遵行方向標誌設於近端。",
            "textKey": "urban-merge-direction|1|text-7"
          },
          {
            "id": "point-original-2",
            "text": "故本示例建議「遵8」設於路口遠端，以車行方向中軸線為原則。",
            "textKey": "urban-merge-direction|1|text-8"
          }
        ]
      }
