        "points": [
          {
            "id": "selection",
            "title": "提前提示支線道穿越方向",
            "titleKey": "results-scenario-c1-02-strategy|results|selection-title",
            "text": "於路口上游設置車道與方向指示標誌，搭配指向線，引導駕駛提前選擇通往對側支線道的車道。",
            "textKey": "results-scenario-c1-02-strategy|results|selection-text",
            "moduleId": "M1-02"
          },
          {
            "id": "continuity",
            "title": "維持兩處路口間的車道連續性",
            "titleKey": "results-scenario-c1-02-strategy|results|continuity-title",
            "text": "調整中央街廓的車道配置，避免直行車道直接銜接左轉專用車道，並以路口行車導引線標示穿越路徑。",
            "textKey": "results-scenario-c1-02-strategy|results|continuity-text",
            "moduleId": "M1-01"
          },
          {
            "id": "walking",
            "title": "配置中央行人庇護島",
            "titleKey": "results-scenario-c1-02-strategy|results|walking-title",
            "text": "於較寬道路中央設置行人庇護空間，提供行人中途停等位置，縮短單次穿越距離。",
            "textKey": "results-scenario-c1-02-strategy|results|walking-text",
            "moduleId": "M3-01"
          },
          {
            "id": "visibility",
            "title": "調整中央街廓號誌位置",
            "titleKey": "results-scenario-c1-02-strategy|results|visibility-title",
            "text": "檢核各車道駕駛能否辨識近、遠端號誌，必要時增設燈面，並配合行穿線及行人停等位置配置行人號誌。",
            "textKey": "results-scenario-c1-02-strategy|results|visibility-text",
            "moduleId": "M2-03"
          }
        ]
      },
      "results-scenario-c1-02": {
        "points": [
          {
            "id": "lanes",
            "title": "直行車道銜接至左轉專用車道",
            "text": "前一個路口的直行車道，通過路口後卻銜接到左轉專用車道，駕駛容易誤入轉向車道。",
            "titleKey": "results-scenario-c1-02|results|lanes-title",
            "textKey": "results-scenario-c1-02|results|lanes-text"
          },
          {
