        "points": [
          {
            "id": "turn",
            "title": "以漸變增設左右轉附加車道",
            "text": "路段維持單向 2 車道，接近路口時透過漸變增設左、右轉專用車道，避免直接將直行車道轉為轉向車道。",
            "moduleId": "M1-01",
