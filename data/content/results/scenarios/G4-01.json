          {
            "id": "turn",
            "title": "左轉車道占用直行車道延續空間",
            "text": "路口直接將內側直行車道轉為左轉專用道，造成左轉車道負偏移，直行車輛須變換行駛位置。",
            "titleKey": "results-scenario-g4-01|results|turn-title",
            "textKey": "results-scenario-g4-01|results|turn-text"
          },
          {
            "id": "pedestrian",
            "title": "行人穿越距離長且缺少庇護島",
            "text": "主要道路寬達 40 m，行人須穿越多個車道，但路口缺少中央庇護空間，難以提供分段穿越及中途停等。",
            "titleKey": "results-scenario-g4-01|results|pedestrian-title",
            "textKey": "results-scenario-g4-01|results|pedestrian-text"
          },
          {
            "id": "lanes",
            "title": "進出路口車道數不一致",
            "text": "上、下游車道數及車道配置不同，缺少足夠的行車導引，駕駛不易判斷應銜接的車道。",
            "titleKey": "results-scenario-g4-01|results|lanes-title",
            "textKey": "results-scenario-g4-01|results|lanes-text"
          },
          {
            "id": "guidance",
            "title": "車道預告標誌距離路口過近",
            "text": "上游車道預告標誌設置位置過於接近路口，駕駛無法提前判斷左、右轉專用車道的位置。",
            "titleKey": "results-scenario-g4-01|results|guidance-title",
            "textKey": "results-scenario-g4-01|results|guidance-text"
          }
        ]
      },
