          {
            "id": "lanes",
            "title": "進環前缺少車道選擇指示",
            "text": "入口未設置足夠的指向線及方向標誌，駕駛不易在進入圓環前選擇通往目的地的車道。",
            "titleKey": "results-scenario-c1-08|results|lanes-title",
            "textKey": "results-scenario-c1-08|results|lanes-text"
          },
          {
            "id": "weaving",
            "title": "環內車道交織衝突較多",
            "text": "環內不同車道的行駛方向及出口對應不明確，駕駛可能在圓環內頻繁變換車道。",
            "titleKey": "results-scenario-c1-08|results|weaving-title",
            "textKey": "results-scenario-c1-08|results|weaving-text"
          },
          {
            "id": "signs",
            "title": "圓環相關標誌配置不足",
            "text": "入口缺少完整的讓路及圓環遵行方向標誌，駕駛不易判斷進環讓路關係與行駛方向。",
            "titleKey": "results-scenario-c1-08|results|signs-title",
            "textKey": "results-scenario-c1-08|results|signs-text"
          },
          {
            "id": "pedestrian",
            "title": "圓環周邊步行空間不足",
            "text": "路側人行空間狹窄，進出環車輛轉向時，可能影響行人通行及穿越空間。",
            "titleKey": "results-scenario-c1-08|results|pedestrian-title",
            "textKey": "results-scenario-c1-08|results|pedestrian-text"
          }
        ]
      },
