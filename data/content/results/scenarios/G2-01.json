          {
            "id": "turn",
            "title": "左、右轉車輛影響直行車流",
            "titleKey": "results-scenario-g2-01|results|turn-title",
            "text": "路口缺少適當的轉向車道，左轉車輛停等及右轉車輛減速時，容易阻礙後方直行車輛。",
            "textKey": "results-scenario-g2-01|results|turn-text"
          },
          {
            "id": "signal",
            "title": "行人號誌未配合行穿線位置",
            "text": "行人專用號誌常與行車管制號誌共桿，若未配合行穿線設置，行人在等待穿越時可能無法直接看見對應燈面。",
            "titleKey": "results-scenario-g2-01|results|signal-title",
            "textKey": "results-scenario-g2-01|results|signal-text"
          },
          {
            "id": "speed",
            "title": "速限標誌與標字不足",
            "titleKey": "results-scenario-g2-01|results|speed-title",
            "text": "市區街廓較短，部分路段缺少速限標誌及路面標字，駕駛不易確認行駛路段的速限。",
            "textKey": "results-scenario-g2-01|results|speed-text"
          }
        ]
      },
      "results-scenario-g2-01-strategy": {
        "points": [
          {
            "id": "lanes",
            "title": "增設左轉專用車道及槽化設施",
            "titleKey": "results-scenario-g2-01-strategy|results|lanes-title",
            "text": "於主要道路配置左轉專用車道，透過槽化線調整路口前後車道配置，減少左轉停等對直行車流的影響。",
            "textKey": "results-scenario-g2-01-strategy|results|lanes-text",
            "moduleId": "M1-01"
          },
          {
            "id": "parking",
            "title": "依道路條件調整路側停車配置",
            "titleKey": "results-scenario-g2-01-strategy|results|parking-title",
            "text": "主要道路因街廓短、速限 50 km/h，本例採禁止路邊停車；次要道路將速限調整為 40 km/h，並配合人行道外擴設置嵌入式停車位。",
            "textKey": "results-scenario-g2-01-strategy|results|parking-text",
            "moduleId": "M1-03"
          },
          {
            "id": "signals",
            "title": "依行穿線位置配置行人號誌",
            "titleKey": "results-scenario-g2-01-strategy|results|signals-title",
            "text": "行人專用號誌應配合行穿線及行人停等位置設置，並檢核行車號誌的近、遠端燈面，確認各方向均能辨識對應號誌。",
            "textKey": "results-scenario-g2-01-strategy|results|signals-text",
            "moduleId": "M2-03"
          },
          {
            "id": "turning",
            "title": "配合左轉方式設置號誌燈面",
            "text": "依左轉車流及衝突情形選擇機會左轉或保護左轉，分別配置對應的三燈式或四燈式號誌，並檢核號誌可視性。",
            "moduleId": "M2-03",
            "titleKey": "results-scenario-g2-01-strategy|results|turning-title",
