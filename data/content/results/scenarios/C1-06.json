    "results": {
      "results-scenario-c1-06": {
        "points": [
          {
            "id": "speed",
            "title": "路口缺少有效的減速設計",
            "text": "現況主要以網狀線提示交叉口位置，但路口範圍較寬，車輛仍可能以較高速度通過。",
            "titleKey": "results-scenario-c1-06|results|speed-title",
            "textKey": "results-scenario-c1-06|results|speed-text"
          },
          {
            "id": "pedestrian",
            "title": "行人通行空間不足",
            "text": "路側步行空間狹窄且不連續，行人通過多叉路口時，容易與車輛動線交織。",
            "titleKey": "results-scenario-c1-06|results|pedestrian-title",
            "textKey": "results-scenario-c1-06|results|pedestrian-text"
          },
          {
            "id": "direction",
            "title": "多叉路型不易提前辨識",
            "text": "路口分支多且交角不規則，缺少對應路型的岔路標誌，駕駛不易提前判斷道路方向。",
            "titleKey": "results-scenario-c1-06|results|direction-title",
            "textKey": "results-scenario-c1-06|results|direction-text"
          },
          {
            "id": "oneway",
            "title": "單行道行向管制不明確",
            "text": "各分支均為單行道，若缺少適當的禁止轉彎及禁止進入標誌，駕駛可能誤入逆向道路。",
            "titleKey": "results-scenario-c1-06|results|oneway-title",
            "textKey": "results-scenario-c1-06|results|oneway-text"
          }
        ]
      },
      "results-scenario-c1-06-strategy": {
        "points": [
          {
            "id": "alignment",
            "title": "調整路型及縮減車道寬度",
            "text": "以標線修整不規則的行車範圍，配合車道縮減及轉角調整，使駕駛減速通過多叉路口。",
            "moduleId": "M1-01",
            "titleKey": "results-scenario-c1-06-strategy|results|alignment-title",
            "textKey": "results-scenario-c1-06-strategy|results|alignment-text"
          },
          {
            "id": "walking",
            "title": "擴大路側步行空間",
            "text": "調整車道及停車帶配置，將部分路側空間留供行人通行，並配合斜交路型設置梯形行穿線。",
            "moduleId": "M3-01",
            "titleKey": "results-scenario-c1-06-strategy|results|walking-title",
            "textKey": "results-scenario-c1-06-strategy|results|walking-text"
          },
          {
            "id": "warning",
            "title": "依實際路型設計岔路標誌",
            "text": "本例路口無法對應既有岔路標誌圖案，因此示範依實際分支形狀繪製岔路警示圖案，協助駕駛辨識前方路型。",
            "moduleId": "M4-01",
            "titleKey": "results-scenario-c1-06-strategy|results|warning-title",
            "textKey": "results-scenario-c1-06-strategy|results|warning-text"
          },
          {
            "id": "oneway",
            "title": "配置單行道與禁止進入標誌",
            "text": "依各分支行車方向設置單行道、禁止進入及禁止轉彎標誌，明確告知駕駛允許通行的方向。",
            "moduleId": "M2-04",
            "titleKey": "results-scenario-c1-06-strategy|results|oneway-title",
            "textKey": "results-scenario-c1-06-strategy|results|oneway-text"
          },
          {
            "id": "signs",
            "title": "依狹窄街巷條件調整標誌設置",
            "text": "優先採用符合規定的縮小型警告及禁制標誌；立桿空間不足時，應另行檢討附掛位置，避免占用人行道淨寬。",
            "titleKey": "results-scenario-c1-06-strategy|results|signs-title",
            "textKey": "results-scenario-c1-06-strategy|results|signs-text"
          }
        ]
      }
    }
  }
}
