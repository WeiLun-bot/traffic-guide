    "results": {
      "results-scenario-c4-04": {
        "points": [
          {
            "id": "entry",
            "title": "迴轉道入口缺少提前分流設計",
            "text": "迴轉道與主線銜接處缺少足夠的漸變長度及導引標線，駕駛可能在接近入口時才急於變換車道。",
            "titleKey": "results-scenario-c4-04|results|entry-title",
            "textKey": "results-scenario-c4-04|results|entry-text"
          },
          {
            "id": "merge",
            "title": "迴轉道出口匯入空間不足",
            "text": "車輛離開迴轉道後須重新匯入主線，若缺少足夠的匯入長度或停讓管制，容易與主線車輛發生衝突。",
            "titleKey": "results-scenario-c4-04|results|merge-title",
            "textKey": "results-scenario-c4-04|results|merge-text"
          },
          {
            "id": "signs",
            "title": "不同目的地的車道資訊混雜",
            "text": "同一區域包含迴轉、直行、上國道及平面道路等多種行向，現況部分方向標誌型式混用，駕駛不易判斷各車道對應的目的地。",
            "titleKey": "results-scenario-c4-04|results|signs-title",
            "textKey": "results-scenario-c4-04|results|signs-text"
          },
          {
            "id": "restrictions",
            "title": "高架橋淨高與支線道轉向限制未明確提示",
            "text": "迴轉道穿越高架橋下方，部分車輛可能受到高度限制；鄰近支線道另有右進右出管制，須提前告知駕駛。",
            "titleKey": "results-scenario-c4-04|results|restrictions-title",
            "textKey": "results-scenario-c4-04|results|restrictions-text"
          }
        ]
      },
      "results-scenario-c4-04-strategy": {
        "points": [
          {
            "id": "selection",
            "title": "於上游明確指示迴轉車道",
            "text": "使用地名方向指示及車道指示標誌，分別標示國道、平面道路與迴轉道的行向，並以迴轉箭頭對應實際車道。",
            "moduleId": "M1-02",
            "titleKey": "results-scenario-c4-04-strategy|results|selection-title",
            "textKey": "results-scenario-c4-04-strategy|results|selection-text"
          },
          {
            "id": "transition",
            "title": "以分流式指向線及穿越虛線引導入口",
            "text": "於迴轉道上游配置直行與迴轉分流式指向線，搭配穿越虛線及附加車道，使車輛能在適當漸變長度內進入迴轉道。",
            "moduleId": "M1-01",
            "titleKey": "results-scenario-c4-04-strategy|results|transition-title",
            "textKey": "results-scenario-c4-04-strategy|results|transition-text"
          },
          {
            "id": "exit",
            "title": "依出口條件採匯入或讓路管制",
            "text": "迴轉道出口若具有足夠的匯入長度，可採匯入式設計；若匯入空間不足，則設置讓路線及讓路標誌，要求車輛確認主線來車後再進入。",
            "moduleId": "M2-01",
            "titleKey": "results-scenario-c4-04-strategy|results|exit-title",
            "textKey": "results-scenario-c4-04-strategy|results|exit-text"
          },
          {
            "id": "confirmation",
            "title": "區分車道預告與車道確認標誌",
            "text": "上游以地名方向指示標誌提供選道資訊，接近分流點再以車道指示標誌確認各車道的目的地，避免兩種牌面設於同一位置。",
            "moduleId": "M1-02",
            "titleKey": "results-scenario-c4-04-strategy|results|confirmation-title",
            "textKey": "results-scenario-c4-04-strategy|results|confirmation-text"
          },
          {
            "id": "restrictions",
            "title": "設置限高與支線道行向管制標誌",
            "text": "在高架橋下方迴轉道入口前設置車輛高度限制標誌；鄰近支線道則配合右進右出管制，設置僅准右轉及讓路標誌。",
            "moduleId": "M4-02",
            "titleKey": "results-scenario-c4-04-strategy|results|restrictions-title",
            "textKey": "results-scenario-c4-04-strategy|results|restrictions-text"
          }
        ]
      }
    }
  }
}
