      "results-scenario-c4-05": {
        "points": [
          {
            "id": "visibility",
            "title": "路側停車影響行人與駕駛視線",
            "text": "行穿線鄰近機車及汽車停車空間，停放車輛可能遮蔽行人，影響駕駛提前察覺穿越需求。",
            "titleKey": "results-scenario-c4-05|results|visibility-title",
            "textKey": "results-scenario-c4-05|results|visibility-text"
          },
          {
            "id": "pedestrian",
            "title": "行人缺少中途庇護及停等空間",
            "text": "行人須穿越多個車道，但現況缺少足夠的中央庇護島及路側停等空間。",
            "titleKey": "results-scenario-c4-05|results|pedestrian-title",
            "textKey": "results-scenario-c4-05|results|pedestrian-text"
          },
          {
            "id": "warning",
            "title": "駕駛不易預期路段中行人穿越",
            "text": "路段中沒有一般交叉口的轉向及號誌提示，若缺少適當警告標誌，駕駛可能在接近行穿線時才注意到穿越處。",
            "titleKey": "results-scenario-c4-05|results|warning-title",
            "textKey": "results-scenario-c4-05|results|warning-text"
          },
          {
            "id": "control",
            "title": "行穿線與號誌搭配須符合規定",
            "text": "路段中斑馬紋行穿線應搭配行人穿越道號誌；若改採枕木紋行穿線及一般行車管制號誌，則涉及現行法規對設置位置與型式的限制。",
            "titleKey": "results-scenario-c4-05|results|control-title",
            "textKey": "results-scenario-c4-05|results|control-text"
          }
        ]
      },
      "results-scenario-c4-05-strategy": {
        "points": [
          {
            "id": "calming",
            "title": "以槽化線及庇護島縮減車行空間",
            "text": "在接近行穿線的位置調整車道線形，設置中央行人庇護島，使車輛減速接近，並提供行人中途停等空間。",
            "moduleId": "M3-01",
            "titleKey": "results-scenario-c4-05-strategy|results|calming-title",
            "textKey": "results-scenario-c4-05-strategy|results|calming-text"
          },
          {
            "id": "parking",
            "title": "調整路側停車位置，避免遮蔽行人",
            "text": "於路側設置停車彎，並使停車空間與行穿線保持約 10 m 間距，避免停放車輛阻礙駕駛與行人的視線。",
            "moduleId": "M1-03",
            "titleKey": "results-scenario-c4-05-strategy|results|parking-title",
            "textKey": "results-scenario-c4-05-strategy|results|parking-text"
          },
          {
            "id": "crossing",
            "title": "設置斑馬紋行穿線及停止線",
            "text": "於道路中段設置斑馬紋行人穿越道線，並於上游約 2～3 m 處劃設停止線，標示車輛應暫停讓行人的位置。",
            "moduleId": "M3-01",
            "titleKey": "results-scenario-c4-05-strategy|results|crossing-title",
            "textKey": "results-scenario-c4-05-strategy|results|crossing-text"
          },
          {
            "id": "warning",
            "title": "以當心行人標誌提前預告穿越位置",
            "text": "在行穿線上游設置當心行人標誌及距離附牌，並配合穿越處附近的警示設施，提醒駕駛注意行人。",
            "moduleId": "M4-01",
            "titleKey": "results-scenario-c4-05-strategy|results|warning-title",
            "textKey": "results-scenario-c4-05-strategy|results|warning-text"
          },
          {
            "id": "consistency",
            "title": "搭配行人穿越道雙閃黃燈號誌",
            "text": "依本示例採斑馬紋行穿線搭配雙閃黃色行人穿越道號誌，提醒車輛減速慢行；有行人穿越時，須暫停於停止線前讓行人優先通行。",
            "moduleId": "M3-01",
            "titleKey": "results-scenario-c4-05-strategy|results|consistency-title",
            "textKey": "results-scenario-c4-05-strategy|results|consistency-text"
          }
        ]
      }
    }
  }
