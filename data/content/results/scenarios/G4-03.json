        "points": [
          {
            "id": "pedestrian",
            "title": "行人穿越距離長且缺少庇護島",
            "text": "路口較為寬廣，行人穿越多個車道時缺少中央庇護空間，無法提供中途安全停等位置。",
            "titleKey": "results-scenario-g4-03|results|pedestrian-title",
            "textKey": "results-scenario-g4-03|results|pedestrian-text"
          },
          {
            "id": "lanes",
            "title": "次要道路上下游車道數不一致",
            "text": "次要道路南側與北側車道配置不同，直行車道有明顯橫向偏移，駕駛不易判斷通過路口後的車道位置。",
            "titleKey": "results-scenario-g4-03|results|lanes-title",
            "textKey": "results-scenario-g4-03|results|lanes-text"
          },
          {
            "id": "bus",
            "title": "公車停靠範圍不明確",
            "text": "路側公車站缺少明確的停靠區標線，其他車輛不易辨識公車進出站位置，容易與公車產生交織。",
            "titleKey": "results-scenario-g4-03|results|bus-title",
            "textKey": "results-scenario-g4-03|results|bus-text"
          },
          {
            "id": "speed",
            "title": "速限與路側停車資訊不足",
            "text": "市區道路停車及路側活動頻繁，若缺少速限與停車管制提示，駕駛不易判斷相關管制範圍。",
            "titleKey": "results-scenario-g4-03|results|speed-title",
            "textKey": "results-scenario-g4-03|results|speed-text"
          }
        ]
      },
      "results-scenario-g4-03-strategy": {
        "points": [
          {
            "id": "walking",
            "title": "設置行人庇護島",
            "text": "於主要道路配置行人庇護島提供中途停等空間。",
            "moduleId": "M3-01",
            "titleKey": "results-scenario-g4-03-strategy|results|walking-title",
            "textKey": "results-scenario-g4-03-strategy|results|walking-text"
          },
          {
            "id": "accessibility",
            "title": "行穿線設置視覺功能障礙引導標線",
            "text": "如有視覺功能障礙者通行需求，可於斜向行穿線配置引導標線，並銜接人行道上的定位磚。",
            "moduleId": "M3-01",
            "titleKey": "results-scenario-g4-03-strategy|results|accessibility-title",
            "textKey": "results-scenario-g4-03-strategy|results|accessibility-text"
          },
          {
            "id": "bus",
            "title": "配合人行道外擴設置公車停車彎",
            "text": "於公車站位置調整人行道路緣，延伸路面邊線並劃設公車停靠區標線，區分公車停靠與一般行車空間。",
            "moduleId": "M3-04",
            "titleKey": "results-scenario-g4-03-strategy|results|bus-title",
            "textKey": "results-scenario-g4-03-strategy|results|bus-text"
