    {
      "id": "m302-lane-issues",
      "section": "module",
      "submoduleId": "M3-02.1",
      "title": "自行車道｜現況議題與相關條文",
      "intro": "自行車道應整體考量路段、路口穿越及不同通行空間的銜接，避免自行車動線中斷或路權關係不明，影響騎乘安全。",
      "defaultView": "pair",
      "assets": [
        "m302-lane-issue-photo-1",
        "m302-lane-issue-photo-2",
        "m302-lane-issue-photo-3"
      ],
      "points": [
        {
          "id": "network",
          "title": "自行車道缺乏連續性",
          "text": "自行車道常於路口、公車站或道路斷面變化處中斷，不同設施型態間的通行空間及路權關係亦不易辨識，可能迫使自行車騎士臨時變換行駛位置。",
          "focus": {
            "asset": "m302-lane-issue-photo-1",
            "assets": [
              "m302-lane-issue-photo-1",
              "m302-lane-issue-photo-2"
            ]
          }
        },
        {
          "id": "crossing",
          "title": "穿越及匯入匯出動線不明確",
          "text": "自行車穿越道的寬度、位置或轉入軌跡未妥善銜接，或自行車道匯入車行道時缺乏適當導引標線，可能造成自行車與其他車流的動線衝突。",
          "focus": {
            "asset": "m302-lane-issue-photo-3",
            "assets": [
              "m302-lane-issue-photo-3"
            ]
          }
        }
      ],
      "sourcePages": [],
      "references": [
        "46",
        "67",
        "174-4",
        "186-1"
      ],
      "applications": [
        "G2-03",
        "C1-02",
        "C4-03"
      ],
      "imageFit": "contain",
      "pointLinkedImages": true
    },
    {
      "id": "m302-lane-diagram",
      "section": "module",
      "submoduleId": "M3-02.1",
      "title": "自行車道｜圖例說明",
      "intro": "透過自行車優先車道、穿越道線及匯入匯出導引設施，明確區分不同用路人的通行空間，維持自行車由路段至路口的動線連續性。",
      "assets": [
        "m302-3167eda215"
      ],
      "points": [
        {
          "id": "priority",
          "title": "依通行對象區分人車空間",
          "text": "於騎樓以外人行道劃設自行車優先車道標線時，僅供腳踏自行車及電動輔助自行車通行；遇行人穿越時，應以行人優先。",
          "focus": {
            "asset": "m302-3167eda215"
          }
        },
        {
          "id": "side",
          "title": "原則配置於靠近車行道側",
          "text": "人行道上的自行車道原則設於靠近車行道的一側，並得依道路空間及現地配置需求調整，維持自行車與行人的通行動線清楚。",
          "focus": {
            "asset": "m302-3167eda215"
          }
        },
        {
          "id": "symbols",
          "title": "於穿越道兩端標示自行車圖案",
          "text": "自行車穿越道線的入口及出口處應分別繪設自行車圖案，使自行車騎士及其他用路人辨識自行車穿越位置。",
          "focus": {
            "asset": "m302-3167eda215"
          }
        },
        {
          "id": "direction",
          "title": "視需要增設方向導引",
          "text": "當自行車穿越方向不易辨識時，可增設指向線，明確提示通行方向，並檢核穿越道位置、寬度及與前後自行車道的銜接關係。",
          "focus": {
            "asset": "m302-3167eda215"
          }
        },
        {
          "id": "merge",
          "title": "匯入車行道時劃設穿越虛線",
          "text": "自行車道由人行道匯入車行道時，應於匯入處劃設穿越虛線，提示自行車騎士注意車行道上的車輛，並明確呈現行駛空間的轉換。",
          "focus": {
            "asset": "m302-3167eda215"
          }
        },
        {
          "id": "warning",
          "title": "視需要預告自行車匯入",
          "text": "得於匯入處上游增設當心自行車標誌，提醒車行道用路人注意前方可能有自行車匯入。",
          "focus": {
            "asset": "m302-3167eda215"
          }
        },
        {
          "id": "exit",
          "title": "明確提示自行車不得續行的空間",
          "text": "自行車道匯出後，若接續的人行道未開放自行車行駛，可增設行人專用標誌，提示自行車騎士不得繼續騎乘進入該人行道。",
          "focus": {
            "asset": "m302-3167eda215"
          }
        }
      ],
      "sourcePages": [],
      "references": [
        "46",
        "67",
        "174-4",
        "186-1"
      ]
    },
    {
      "id": "m302-lane-extensions",
      "section": "module",
      "submoduleId": "M3-02.1",
      "title": "自行車遵循號誌的檢討",
      "intro": "把自行車路段、穿越與匯入車行道的動線連續安排。",
      "assets": [],
      "points": [
        {
          "id": "proposal",
          "title": "清楚區分修訂建議與現行配置",
          "text": "本模組提出檢討方向：釐清人行道或同平面自行車道穿越時，應遵循的號誌對象。"
        },
        {
          "id": "shared",
          "title": "共用燈面需有明確適用依據",
          "text": "可研議自行車或人車共用鏡面；若後續規定允許，建議共用燈面設於自行車與行人穿越道之間。"
        }
      ],
      "sourcePages": [],
      "references": [
        "46",
        "67",
        "174-4",
        "186-1"
      ]
    },
