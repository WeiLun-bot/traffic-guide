    {
      "id": "m302-lane-diagram",
      "section": "module",
      "submoduleId": "M3-02.1",
      "title": "自行車道｜圖例說明",
      "intro": "對照圖例，逐項檢視設施位置與配置方式。",
      "assets": [
        "m302-b172c5ac34",
        "m302-3167eda215"
      ],
      "points": [
        {
          "id": "priority",
          "title": "人行道上仍以行人穿越優先",
          "text": "設於騎樓以外人行道的自行車優先車道，供腳踏及電動輔助自行車通行；遇行人穿越時先讓行人。"
        },
        {
          "id": "side",
          "title": "原則靠近車行道側布設",
          "text": "必要時依道路空間及現地配置調整，維持動線清楚。"
        },
        {
          "id": "symbols",
          "title": "入口、出口分別標示自行車圖案",
          "text": "需要說明方向時，可加設指向線，讓騎士辨識穿越路徑。"
        },
        {
          "id": "merge",
          "title": "匯入車行道以穿越虛線提示",
          "text": "提醒騎士注意車行道來車；必要時在上游加設當心自行車標誌。"
        },
        {
          "id": "exit",
          "title": "未開放騎乘的人行道清楚告知",
          "text": "匯出端若接續未開放自行車的人行道，可加設行人專用標誌，提示不得繼續騎乘。"
        }
      ],
      "sourcePages": [],
