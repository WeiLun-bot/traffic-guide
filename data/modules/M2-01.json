      "assets": [
        "stop-basic"
      ],
      "points": [
        {
          "id": "sign",
          "title": "停車再開標誌",
          "text": "設在駕駛看得見、靠近幹道的位置。以右側為原則，必要時增設於交通島或左側；優先以標誌提醒停車再開。",
          "focus": {
            "asset": "stop-basic",
            "rect": [
              710,
              155,
              190,
              180
            ]
          }
        },
        {
          "id": "line",
          "title": "停止線位置",
          "text": "設在能觀察幹道來車的位置，一般可與幹道路面邊線延伸線切齊。",
          "focus": {
            "asset": "stop-basic",
            "rect": [
              463,
              79,
              205,
              32
            ]
          }
        },
        {
          "id": "buffer",
