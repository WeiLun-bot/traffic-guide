          "focus": {
            "asset": "stop-basic",
            "rect": [
              230,
              79,
              228,
              29
            ]
          }
        },
        {
          "id": "walk",
          "title": "行人穿越位置",
          "text": "圖中以緣石開口與淺色鋪面，標示行人穿越的參考範圍。"
