  "pages": [
    {
      "id": "m201-overview",
      "section": "overview",
      "title": "M2-01 停、讓管制",
      "intro": "以標誌宣告通行優先關係，再由標線明確化停讓位置與路口配置。",
      "assets": [
        "stop-basic",
        "yield-basic"
      ],
      "points": [
        {
          "id": "purpose",
          "title": "先建立主次道路關係",
          "text": "停、讓管制均以幹道車輛優先通行為核心；標誌、標線及視距條件需一起檢視。"
        },
        {
          "id": "stop",
          "title": "M2-01.1 停管制",
          "text": "以停車再開標誌、停止線與停標字等設施，示範停讓幹道車輛的位置及配置。"
        },
        {
          "id": "yield",
          "title": "M2-01.2 讓管制",
          "text": "以讓路標誌、讓路線與相關標線，提醒減速並讓幹道車輛先行。"
        },
        {
          "id": "read",
          "title": "閱讀方式",
          "text": "先看現況與議題，再逐項檢視基本配置，最後對照行穿線、庇護空間、槽化與高速環境等延伸應用。"
        }
      ],
      "sourcePages": [
        46,
        47,
        48,
        49,
        50,
        51
      ],
      "mode": "pair",
      "references": [
        "16",
        "58",
        "59",
        "149",
        "170",
        "172",
        "177",
        "189"
      ]
    },
    {
      "id": "m201-stop-issues",
      "submoduleId": "M2-01.1",
      "section": "stop",
      "title": "停管制：先檢視停車位置與視距",
      "intro": "停止線的位置，應與實際觀察主要道路來車的需求一起檢視。",
      "assets": [
        "stop-basic"
      ],
      "points": [
        {
          "id": "sight",
          "title": "停在停止線，是否看得見來車？",
          "text": "原稿指出，停管制路口的停止線若過於退縮，且視距三角受限，駕駛人即使依線停車，仍可能無法充分觀察主要道路來車。",
          "focus": {
            "asset": "stop-basic",
            "rect": [
              380,
              65,
              295,
              95
            ]
          }
        },
        {
          "id": "notice",
          "title": "標誌與停標字的提醒時機不同",
          "text": "停車再開標誌設於路側，可在較遠處提醒前方為停管制路口；路面上的「停」標字，則主要於接近路口時提醒。",
          "focus": {
            "asset": "stop-basic",
            "rect": [
              710,
              155,
              190,
              180
            ]
          }
        },
        {
          "id": "composition",
          "title": "把設施放在一起理解",
          "text": "基本配置包括停車再開標誌、停止線、停標字及路口行車導引線；各設施的提示目的與相對位置需一併說明。"
        },
        {
          "id": "standards",
          "title": "視距判別的原稿依據",
          "text": "原稿另指向《交工規範》解說 C6.3；市區道路參照《市區道路及附屬工程設計規範》，省道公路參照《公路路線設計規範》第 3.3 節。"
        }
      ],
      "sourcePages": [
        46
      ],
      "references": [
        "58",
        "170",
        "177",
        "189"
      ]
    },
    {
      "id": "m201-stop-layout",
      "submoduleId": "M2-01.1",
      "section": "stop",
      "title": "停管制：基本配置逐點看",
      "intro": "點選下方項目，對照各設施在代表圖中的角色。",
      "assets": [
        "stop-basic"
      ],
      "points": [
        {
          "id": "sign",
          "title": "停車再開標誌",
          "text": "在臨近路口駕駛人可見的條件下，盡可能接近幹道，強化停讓對象為幹道車輛的概念。原則設於右側，視需要增設於交通島或左側；以標誌優先宣告管制，減少前車、停車、濕潤、磨耗與視角壓縮等因素的影響。",
          "focus": {
            "asset": "stop-basic",
            "rect": [
              710,
              155,
              190,
              180
            ]
          }
        },
        {
          "id": "line",
          "title": "停止線與視野參考線",
          "text": "原稿以駕駛能觀察主要道路來車的位置為原則，一般可與幹道路面邊線延伸線切齊；並說明此概念與其所引《維也納道路標誌與號誌公約》相符。",
          "focus": {
            "asset": "stop-basic",
            "rect": [
              463,
              79,
              205,
              32
            ]
          }
        },
        {
          "id": "buffer",
          "title": "鄉區高速環境的緩衝",
          "text": "在視距允許時，可將支道停止線設於距幹道路面邊線延伸線 1.5 m 處，形成主次道路交會的緩衝空間；須連同原稿的環境與視距條件判讀。"
        },
        {
          "id": "word",
          "title": "停標字與停止線的距離",
          "text": "停標字佈設於停止線上游，原稿列出的間距為 2 m 至 15 m。",
          "focus": {
            "asset": "stop-basic",
            "rect": [
              493,
              158,
              64,
              96
            ]
          }
        },
        {
          "id": "guide",
          "title": "路口行車導引線",
          "text": "以導引線標示幹道路面邊線的延伸，協助次要道路車輛掌握觀察來車的位置；有行人或自行車穿越道線時，亦作為視距參考線。",
          "focus": {
            "asset": "stop-basic",
            "rect": [
              230,
              79,
              228,
              29
            ]
          }
        },
        {
          "id": "walk",
          "title": "行人穿越位置",
          "text": "代表圖於緣石開口處以淺色鋪面示意行人可穿越的參考範圍，用於說明行人動線與停管制設施配置的關係。"
        }
      ],
      "sourcePages": [
        47
      ],
      "references": [
        "16",
        "58",
        "170",
        "177",
        "189"
      ]
    },
    {
      "id": "m201-stop-crosswalk",
      "submoduleId": "M2-01.1",
      "section": "stop",
      "title": "停管制搭配行穿線",
      "intro": "先停讓行人，再到能觀察幹道來車的位置判斷通行。",
      "assets": [
        "stop-crosswalk"
      ],
      "points": [
        {
          "id": "pedestrian",
          "title": "停止線的主要功能有所區分",
          "text": "有行人穿越道線時，停止線用來指示停讓行人的位置；此處未必是觀察左右來車的最佳位置，駕駛可能需再前移至適當位置觀察。",
          "focus": {
            "asset": "stop-crosswalk",
            "rect": [
              375,
              130,
              234,
              180
            ]
          }
        },
        {
          "id": "second",
          "title": "保留二次觀察的位置",
          "text": "原稿說明，設有行人或自行車穿越道線時，應增設路面邊線延伸線作為視距參考線，供車輛二次停止觀察左右來車。",
          "focus": {
            "asset": "stop-crosswalk",
            "rect": [
              258,
              54,
              425,
              33
            ]
          }
        },
        {
          "id": "sign",
          "title": "標誌設於行穿線下游",
          "text": "原稿以維持停讓幹道車輛的意義為目的，將停車再開標誌設於行穿線下游，提醒停讓行人後起駛的駕駛再次停讓幹道車輛。",
          "focus": {
            "asset": "stop-crosswalk",
            "rect": [
              713,
              171,
              188,
              176
            ]
          }
        },
        {
          "id": "gap",
          "title": "停止線與枕木紋行穿線的淨距",
          "text": "原稿以 2 m 至 3 m 為原則，受現地條件限制可調整，但不得少於 1 m；尺寸與適用條件一併保留。",
          "focus": {
            "asset": "stop-crosswalk",
            "rect": [
              484,
              221,
              116,
              90
            ]
          }
        }
      ],
      "sourcePages": [
