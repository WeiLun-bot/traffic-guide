      ],
      "points": [
        {
          "id": "purpose",
          "title": "建立主次路權",
          "text": "以幹道車輛優先為原則，一起檢視標誌、標線與視距。"
        },
        {
          "id": "stop",
          "title": "M2-01.1 停管制",
          "text": "以停車再開標誌、停止線與停標字，明確標示停讓位置。"
        },
        {
          "id": "yield",
          "title": "M2-01.2 讓管制",
          "text": "以讓路標誌與讓路線，提醒減速並讓幹道車輛先行。"
        },
        {
          "id": "read",
          "title": "配置重點",
          "text": "先確認主次路權，再依行人動線、視距與車速調整配置。"
        }
      ],
