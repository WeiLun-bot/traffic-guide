      "id": "m301-overview",
      "section": "overview",
      "title": "M3-01 行人",
      "intro": "從連續步行空間，到路口與路段穿越，整合標線、庇護與號誌。",
      "overviewGroups": {
        "M3-01.1": {
          "assets": [
            "m301-1ce77bf207",
            "m301-7f710fdd90"
          ]
        },
        "M3-01.2": {
          "assets": [
            "m301-d5772b64b2",
            "m301-4b73804d52"
          ]
        },
        "M3-01.3": {
          "assets": [
            "m301-c80421bad4"
          ]
        }
      },
      "assets": [
        "m301-d5772b64b2",
        "m301-c80421bad4"
      ],
      "points": [
        {
          "id": "sidewalk",
          "title": "M3-01.1 人行道標線",
          "text": "規劃連續步行動線，並依速率與衝突風險檢討實體防護。",
          "submoduleId": "M3-01.1"
        },
        {
          "id": "crossing",
          "title": "M3-01.2 路口穿越",
          "text": "協調行穿線、停等位置與行人號誌的可辨識性。",
          "submoduleId": "M3-01.2"
        },
        {
          "id": "midblock",
          "title": "M3-01.3 路段穿越",
          "text": "以分段穿越、警告與位置提示，協助行人安全通過。",
          "submoduleId": "M3-01.3"
        }
      ],
      "sourcePages": [],
      "references": []
    },
    {
      "id": "m301-sidewalk-issues",
      "section": "module",
      "submoduleId": "M3-01.1",
      "title": "人行道標線｜現況議題與相關條文",
      "intro": "人行道標線可於缺乏實體人行道的道路提供步行空間，惟仍須兼顧人行動線連續性及道路速率環境，才能維持行人通行安全。",
      "assets": [
        "m301-sidewalk-issue-photo-1",
        "m301-sidewalk-issue-photo-2"
      ],
      "points": [
        {
          "id": "continuity",
          "title": "人行道標線缺乏連續性",
          "text": "人行道標線常以局部路段個別劃設，未能整體考量前後路段及路口轉角的銜接，容易出現標線中斷、偏移或寬度不足等情形，迫使行人繞行或進入車道。",
          "focus": {
            "asset": "m301-sidewalk-issue-photo-1"
          }
        },
        {
          "id": "protection",
          "title": "高車速或高衝突環境仍僅以標線區隔",
          "text": "人行道標線不具實體防護功能，原則適用於速限 30 km/h 以下的道路。若道路車速較高或人車衝突風險較大，仍僅以標線區隔人車空間，可能難以提供足夠的行人安全防護。",
          "focus": {
            "asset": "m301-sidewalk-issue-photo-2"
          }
        }
      ],
      "sourcePages": [],
      "references": [
        "174-3"
      ],
      "applications": [
        "G1-01",
        "G1-04",
        "G2-04",
        "G3-04"
      ],
      "pointLinkedImages": true,
      "defaultView": "single",
      "imageFit": "contain"
    },
    {
      "id": "m301-sidewalk-diagram",
      "section": "module",
      "submoduleId": "M3-01.1",
      "title": "人行道標線｜圖例說明",
      "intro": "依道路速率及人車衝突風險選擇適當的人行空間設施，並整合前後路段、路口轉角及車輛轉彎軌跡，建立連續且安全的步行動線。",
      "assets": [
        "m301-1ce77bf207",
        "m301-7f710fdd90",
        "m301-turning-trajectories"
      ],
      "points": [
        {
          "id": "sidewalk",
          "title": "依道路條件選擇人車分隔方式",
          "text": "道路缺乏實體人行道時，可利用人行道標線提供步行空間，原則適用於速限 30 km/h 以下的環境；當車速較高或人車衝突風險較大時，應考量實體人行道或其他適當的阻隔設施。",
          "focus": {
            "asset": "m301-1ce77bf207"
          }
        },
        {
          "id": "connection",
          "title": "確保前後路段與路口動線連續",
          "text": "人行道標線應整體銜接前後路段及路口各側的人行空間，避免於路口轉角或道路交會處中斷，提供行人連續的通行路徑。",
          "focus": {
            "asset": "m301-7f710fdd90"
          }
        },
        {
          "id": "point-4b4138df-a129-4b24-8c70-aa96bb14900f",
          "title": "兼顧車輛轉彎需求與行人空間",
          "text": "以低速轉彎及行人安全為原則，依設計車種轉彎軌跡檢核轉角線形，在滿足必要轉彎空間的前提下，避免過度擴大轉角，維持連續且順暢的行人通行空間。",
          "topicId": "continuity",
          "illustration": "m301-turning-trajectories",
          "illustrationPlacement": "below"
        }
      ],
      "sourcePages": [],
      "references": [
        "174-3"
      ]
    },
    {
      "id": "m301-sidewalk-extensions",
      "section": "module",
      "submoduleId": "M3-01.1",
      "title": "實體阻隔設施",
      "intro": "讓人行空間跨越路段與轉角，形成連續的步行路徑。",
      "assets": [],
      "points": [
        {
          "id": "need",
          "title": "依速率與衝突風險選擇防護",
          "text": "當僅靠標線不足以提供安全步行空間時，檢討實體分隔方式。"
        },
        {
          "id": "guidelines",
          "title": "車阻、護欄與欄杆配合專門指引",
          "text": "配置可參照國土管理署行人交通安全設施及車阻、護欄、欄杆相關指引。"
        }
      ],
      "sourcePages": [],
      "references": [
        "174-3"
      ]
    },
    {
      "id": "m301-crossing-issues",
      "section": "module",
      "submoduleId": "M3-01.2",
      "title": "路口穿越｜現況議題與相關條文",
      "intro": "路口行人穿越設施應兼顧穿越動線、距離、停等空間及號誌辨識性，提供行人安全且連續的通行環境。",
      "defaultView": "single",
      "assets": [
        "m301-crossing-issue-photo-1",
        "m301-crossing-issue-photo-2"
      ],
      "points": [
        {
          "id": "marking",
          "title": "行人穿越道線方向及銜接不當",
          "text": "枕木紋行人穿越道線未與車流方向平行，或與兩側人行道開口銜接不良，可能影響標線辨識性及行人穿越動線的連續性。",
          "focus": {
            "asset": "m301-crossing-issue-photo-1"
          }
        },
        {
          "id": "distance",
          "title": "穿越距離過長且缺乏庇護空間",
          "text": "寬闊或斜交路口的行人穿越距離較長，若缺乏行人庇護島，將增加行人暴露於車流中的時間，並提高高齡者、兒童及行動不便者的穿越負擔。",
          "focus": {
            "asset": "m301-crossing-issue-photo-1"
          }
        },
        {
          "id": "signals",
          "title": "行人專用號誌辨識性不足",
          "text": "行人號誌位置偏離穿越路徑、燈面朝向不當或受到遮蔽，可能使行人難以找到應遵循的燈面，甚至誤判路口的號誌管制方式。",
          "focus": {
            "asset": "m301-crossing-issue-photo-2"
          }
        }
