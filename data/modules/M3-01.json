  "pages": [
    {
      "id": "m301-overview",
      "section": "overview",
      "title": "M3-01 行人",
      "intro": "從連續步行空間，到路口與路段穿越，整合標線、庇護與號誌。",
      "assets": [
        "m301-d5772b64b2",
        "m301-c80421bad4"
      ],
      "points": [
        {
          "id": "sidewalk",
          "title": "M3-01.1 人行道標線",
          "text": "規劃連續步行動線，並依速率與衝突風險檢討實體防護。",
          "submoduleId": "M3-01.1"
        },
        {
          "id": "crossing",
          "title": "M3-01.2 路口穿越",
          "text": "協調行穿線、停等位置與行人號誌的可辨識性。",
          "submoduleId": "M3-01.2"
        },
        {
          "id": "midblock",
          "title": "M3-01.3 路段穿越",
          "text": "以分段穿越、警告與位置提示，協助行人安全通過。",
          "submoduleId": "M3-01.3"
        }
      ],
      "sourcePages": [],
      "references": []
    },
    {
      "id": "m301-sidewalk-issues",
      "section": "module",
      "submoduleId": "M3-01.1",
      "title": "人行道標線｜現況議題與相關條文",
      "intro": "讓人行空間跨越路段與轉角，形成連續的步行路徑。",
      "assets": [
        "m301-1ce77bf207",
        "m301-7f710fdd90"
      ],
      "points": [
        {
          "id": "continuity",
          "title": "人行動線在轉角與路段銜接處中斷",
          "text": "標線偏移、寬度不足或不連續，可能迫使行人繞行或走入車道。"
        },
        {
          "id": "protection",
          "title": "標線不能取代實體防護",
          "text": "原則用於速限 30 km/h 以下環境；速限較高或人車衝突風險高時，應檢討實體人行道或分隔設施。"
        }
      ],
      "sourcePages": [],
      "references": [
        "174-3"
      ],
      "applications": [
        "G1-01",
        "G1-04",
        "G2-04",
        "G3-04"
      ]
    },
    {
      "id": "m301-sidewalk-diagram",
      "section": "module",
      "submoduleId": "M3-01.1",
      "title": "人行道標線｜圖例說明",
      "intro": "對照圖例，逐項檢視設施位置與配置方式。",
      "assets": [
        "m301-1ce77bf207",
        "m301-7f710fdd90"
      ],
      "points": [
        {
          "id": "sidewalk",
          "title": "無實體人行道時安排步行空間",
          "text": "可於路面劃設人行道標線，並使交叉口各側彼此銜接。"
        },
        {
          "id": "connection",
          "title": "前後路段與轉角一起規劃",
          "text": "避免在路口開口、車道出入口或轉角處中斷行人動線。"
        },
        {
          "id": "turning",
          "title": "線形配合設計車種",
          "text": "依轉彎軌跡檢核轉角曲率，並配合市區道路或公路適用的設計規範。"
        }
      ],
      "sourcePages": [],
      "references": [
        "174-3"
      ]
    },
    {
      "id": "m301-sidewalk-extensions",
      "section": "module",
      "submoduleId": "M3-01.1",
      "title": "實體阻隔設施",
      "intro": "讓人行空間跨越路段與轉角，形成連續的步行路徑。",
      "assets": [],
      "points": [
        {
          "id": "need",
          "title": "依速率與衝突風險選擇防護",
          "text": "當僅靠標線不足以提供安全步行空間時，檢討實體分隔方式。"
        },
        {
          "id": "guidelines",
          "title": "車阻、護欄與欄杆配合專門指引",
          "text": "配置可參照國土管理署行人交通安全設施及車阻、護欄、欄杆相關指引。"
        }
      ],
      "sourcePages": [],
      "references": [
        "174-3"
      ]
    },
    {
      "id": "m301-crossing-issues",
      "section": "module",
      "submoduleId": "M3-01.2",
      "title": "路口穿越｜現況議題與相關條文",
      "intro": "把穿越路徑、停等空間與行人號誌一起檢查。",
      "assets": [
        "m301-d5772b64b2",
        "m301-4b73804d52"
      ],
      "points": [
        {
          "id": "marking",
          "title": "枕木紋方向與車流不一致",
          "text": "標線辨識性與銜接方式，需配合車流方向及人行道開口檢查。"
        },
        {
          "id": "distance",
          "title": "寬闊或斜交路口穿越距離過長",
          "text": "穿越長度達 15 m 以上宜設庇護島，達 25 m 以上應設置，並可利用中央分隔島。"
        },
        {
          "id": "signals",
          "title": "行人不容易找到應遵循的燈面",
          "text": "位置偏離、朝向不當或遮擋，都可能使行人誤判路口的管制方式。"
        }
      ],
      "sourcePages": [],
      "references": [
        "185",
        "185-1",
        "194",
        "200",
        "201",
        "220",
        "222",
        "231"
      ],
      "applicationNote": "通用模組，適用於各類號誌化路口行人穿越情境。"
    },
    {
      "id": "m301-crossing-diagram",
      "section": "module",
      "submoduleId": "M3-01.2",
      "title": "路口穿越｜圖例說明",
      "intro": "對照圖例，逐項檢視設施位置與配置方式。",
      "assets": [
        "m301-d5772b64b2",
        "m301-4b73804d52",
        "m301-f381b3cba3",
        "m301-881f861887",
        "m301-49391268dd",
        "m301-7c404c416a",
        "m301-3813d0ba8d",
        "m301-b5bb22f221"
      ],
      "points": [
        {
          "id": "orientation",
          "title": "枕木紋平行車流方向",
          "text": "配合人行道開口與道路邊緣銜接，維持清楚、連續的穿越路徑。"
        },
        {
          "id": "edge",
          "title": "從路側邊緣開始劃設",
          "text": "可自緣石、人行道標線或禁臨停線邊緣起畫；遇交通島採分段處理。"
        },
        {
          "id": "guide",
          "title": "視覺功能障礙引導標線銜接兩端",
          "text": "有需求、距離長或斜交時，可檢討引導標線，並對準人行道定位磚。"
        },
        {
          "id": "refuge",
          "title": "穿越距離與中途停等一起規劃",
          "text": "配合庇護島檢討分段穿越；完整導盲設計參照市區道路人行道路口導盲設施設計指南。"
        },
        {
          "id": "diagonal",
          "title": "行人專用時相可搭配對角線",
          "text": "依需求劃設 X 字型平行白色實線。"
        },
        {
          "id": "hours",
          "title": "時段性實施需標示時間",
          "text": "在對角線四個端點布設時段標字，讓行人辨識開放時間。"
        },
        {
          "id": "roadside",
          "title": "路側式號誌配合來車方向",
          "text": "本指引建議可朝來車方向安排燈面，讓行人在等候位置容易辨認。"
        },
        {
          "id": "base",
          "title": "基座埋於鋪面下",
          "text": "減少突出障礙，並檢核燈面與穿越路徑的水平距離及縱深。"
        },
        {
          "id": "size",
          "title": "依尺寸圖檢查燈面與按鈕",
          "text": "同時檢視燈箱、按鈕與安裝位置，避免因共桿設置降低可辨識性。"
        },
        {
          "id": "pole",
          "title": "與行車管制號誌共桿時分別檢核",
          "text": "燈面朝向與行人路徑對應，保留行走淨空與操作空間。"
        },
        {
          "id": "search",
          "title": "檢查等候位置能否清楚看見",
          "text": "燈面若偏離預期搜尋範圍，行人可能未察覺該處有號誌管制。"
        },
        {
          "id": "standard",
          "title": "優先採用標準配置",
          "text": "對照圖例確認燈面、按鈕與穿越路徑的相對位置。"
        },
        {
          "id": "flashing",
          "title": "行車號誌閃光運轉時",
          "text": "行人紅燈採閃光顯示；行人先停止、確認左右來車並注意安全後再穿越。"
        },
        {
          "id": "steady",
          "title": "行車綠燈恆亮時",
          "text": "行車號誌採三色運轉、綠燈恆亮時，本指引建議行人紅燈維持恆亮。"
        }
      ],
      "sourcePages": [],
      "references": [
        "185",
        "185-1",
        "194",
        "200",
        "201",
        "220",
        "222",
        "231"
      ]
    },
    {
      "id": "m301-crossing-extensions",
      "section": "module",
      "submoduleId": "M3-01.2",
      "title": "全向穿越的斜向燈面",
      "intro": "把穿越路徑、停等空間與行人號誌一起檢查。",
      "assets": [
        "m301-6c801912e9",
        "m301-c4c1d1f196"
      ],
      "points": [
        {
          "id": "direction",
          "title": "燈面朝向對角線穿越路徑",
          "text": "讓等候的行人直接辨識，減少側看其他方向燈面的情形。"
        },
        {
          "id": "timing",
