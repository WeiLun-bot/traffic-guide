  "pages": [
    {
      "id": "m204-overview",
      "section": "overview",
      "title": "M2-04 路口行向管制",
      "intro": "統一道路可行方向、島頭導引與單行道入口的辨識方式。",
      "overviewGroups": {
        "M2-04.1": {
          "assets": [
            "m204-08538b11c2",
            "m204-7592970ada"
          ]
        },
        "M2-04.2": {
          "assets": [
            "m204-e6f9a94e50",
            "m204-55b65042db"
          ]
        },
        "M2-04.3": {
          "assets": [
            "m204-8bd169718b"
          ]
        }
      },
      "assets": [
        "m204-08538b11c2",
        "m204-55b65042db"
      ],
      "points": [
        {
          "id": "movement",
          "title": "M2-04.1 行駛動線遵行與限制",
          "text": "配合近、遠端位置，清楚說明可行方向及禁止轉向。",
          "submoduleId": "M2-04.1"
        },
        {
          "id": "island",
          "title": "M2-04.2 交通島通行導引",
          "text": "依通行側、標誌高度與車流淨距，提示交通島位置。",
          "submoduleId": "M2-04.2"
        },
        {
          "id": "oneway",
          "title": "M2-04.3 單行道",
          "text": "入口與出口採一致配置，降低誤入逆向的可能。",
          "submoduleId": "M2-04.3"
        }
      ],
      "sourcePages": [],
      "references": []
    },
    {
      "id": "m204-movement-issues",
      "section": "module",
      "submoduleId": "M2-04.1",
      "title": "行駛動線遵行與限制｜現況議題與相關條文",
      "intro": "路口行駛方向可透過遵行或禁行標誌進行管制，惟標誌選用、組合及設置位置缺乏一致性，可能使駕駛人難以正確判斷通行方向。",
      "defaultView": "single",
      "imageFit": "contain",
      "assets": [
        "m204-movement-issue-photo-1",
        "m204-movement-issue-photo-2"
      ],
      "points": [
        {
          "id": "choice",
          "title": "標誌選用與設置位置缺乏一致性",
          "text": "遵行與禁行方向標誌的選用、組合及設置位置未能配合駕駛人行駛動線與辨識需求，可能使管制資訊不易判讀，導致駕駛人違規轉向或誤入禁止通行方向。",
          "focus": {
            "asset": "m204-movement-issue-photo-1"
          }
        },
        {
          "id": "position",
          "title": "僅以指向線導引，管制資訊不足",
          "text": "部分路口僅利用路面指向線提示行駛方向，缺乏相對應的遵行或禁行標誌，可能使駕駛人無法明確辨識轉向限制，增加違規轉向或誤入禁止通行方向的風險。",
          "focus": {
            "asset": "m204-movement-issue-photo-2"
          }
        }
      ],
      "sourcePages": [],
      "references": [
        "49",
        "61",
        "73",
        "74"
      ],
      "applications": [
        "G1-01",
        "G1-02",
        "G1-05",
