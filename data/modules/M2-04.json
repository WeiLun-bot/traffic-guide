  "pages": [
    {
      "id": "m204-overview",
      "section": "overview",
      "title": "M2-04 路口行向管制",
      "intro": "統一道路可行方向、島頭導引與單行道入口的辨識方式。",
      "assets": [
        "m204-08538b11c2",
        "m204-55b65042db"
      ],
      "points": [
        {
          "id": "movement",
          "title": "M2-04.1 行駛動線遵行與限制",
          "text": "配合近、遠端位置，清楚說明可行方向及禁止轉向。",
          "submoduleId": "M2-04.1"
        },
        {
          "id": "island",
          "title": "M2-04.2 交通島通行導引",
          "text": "依通行側、標誌高度與車流淨距，提示交通島位置。",
          "submoduleId": "M2-04.2"
        },
        {
          "id": "oneway",
          "title": "M2-04.3 單行道",
          "text": "入口與出口採一致配置，降低誤入逆向的可能。",
          "submoduleId": "M2-04.3"
        }
      ],
      "sourcePages": [],
      "references": []
    },
    {
      "id": "m204-movement-issues",
      "section": "module",
      "submoduleId": "M2-04.1",
      "title": "行駛動線遵行與限制｜現況議題與相關條文",
      "intro": "先讓駕駛看懂可行方向，再配合近、遠端位置表達限制。",
      "assets": [
        "m204-08538b11c2",
        "m204-7592970ada"
      ],
      "points": [
        {
          "id": "choice",
          "title": "標誌選用與組合不一致",
          "text": "遵行方向與禁行方向若缺乏一致用法，駕駛不易判斷可以往哪裡行駛。"
        },
        {
          "id": "position",
          "title": "標誌位置未配合辨識需求",
          "text": "僅靠指向線，或近、遠端標誌位置不當，都可能造成違規轉向或誤入。"
        }
      ],
      "sourcePages": [],
      "references": [
        "49",
        "61",
        "73",
        "74"
      ],
