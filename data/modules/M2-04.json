    {
      "id": "m204-island-diagram",
      "section": "module",
      "submoduleId": "M2-04.2",
      "title": "交通島通行導引｜圖例說明",
      "intro": "對照圖例，逐項檢視設施位置與配置方式。",
      "assets": [
        "m204-e6f9a94e50",
        "m204-55b65042db"
      ],
      "points": [
        {
          "id": "keep",
          "title": "依允許通行側明確導引",
          "text": "靠右行駛標誌指示從右側通過，避免碰撞島頭或誤入對向。"
        },
        {
          "id": "height",
          "title": "高度與橫向淨距一起檢查",
          "text": "標誌底邊不低於路面 0.60 m，並盡量貼近駕駛視點；橫向淨距建議 0.50 m 以上。"
        },
        {
          "id": "split",
          "title": "分流端可由兩側通過",
          "text": "設於分流端部，提示車流可依各自行駛路徑從左側或右側通過。"
        }
      ],
      "sourcePages": [],
      "references": [
        "32",
        "64",
        "162"
      ]
    },
    {
      "id": "m204-island-extensions",
      "section": "module",
      "submoduleId": "M2-04.2",
      "title": "島頭危險標記",
      "intro": "以通行方向、高度與淨距，讓島頭位置更容易辨識。",
      "assets": [
        "m204-e6f9a94e50",
        "m204-55b65042db"
      ],
      "points": [
        {
          "id": "marker",
          "title": "加強交通島位置辨識",
          "text": "可於靠右行駛標誌或分道標誌下方加設危險標記，提示島頭位置。"
        },
        {
          "id": "coordination",
          "title": "依交通功能搭配其他標誌",
          "text": "與讓路、禁止左轉等管制一起檢視，維持方向、路權與島頭導引的一致性。"
        }
      ],
      "sourcePages": [],
