      ]
    },
    {
      "id": "m204-island-issues",
      "section": "module",
      "submoduleId": "M2-04.2",
      "title": "交通島通行導引｜現況議題與相關條文",
      "intro": "交通島標誌應明確提示車輛通行方向及島頭位置，惟標誌設置高度與橫向淨距不當，可能影響駕駛人辨識及通行安全。",
      "defaultView": "pair",
      "assets": [
        "m204-island-issue-photo-1",
        "m204-island-issue-photo-2",
        "m204-island-issue-photo-3"
      ],
      "points": [
        {
          "id": "association",
          "title": "標誌高度與交通島位置不易對應",
          "text": "靠右、靠左行駛標誌及分道標誌若設置過高，可能使駕駛人難以直觀辨識標誌與交通島的對應關係，降低島頭位置及通行方向的辨識性。",
          "focus": {
            "asset": "m204-island-issue-photo-2"
          }
        },
        {
          "id": "clearance",
          "title": "標誌與車流間的橫向淨距不足",
          "text": "交通島上的標誌及危險標記若距離車道過近，可能侵入車輛行駛空間，增加車輛碰撞交通設施的風險。",
          "focus": {
            "asset": "m204-island-issue-photo-1",
            "assets": [
              "m204-island-issue-photo-1",
              "m204-island-issue-photo-3"
            ]
          }
        }
      ],
