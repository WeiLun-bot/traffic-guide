        "G1-03",
        "G1-04",
        "C1-06",
        "C4-03",
        "C4-01",
        "C2-02"
      ],
      "pointLinkedImages": true
    },
    {
      "id": "m204-movement-diagram",
      "section": "module",
      "submoduleId": "M2-04.1",
      "title": "行駛動線遵行與限制｜圖例說明",
      "intro": "依據路口行駛方向的管制需求，選用現行《設置規則》所提供的遵行或禁行標誌牌面，並配合箭頭形式與駕駛人辨識需求，決定近遠端設置位置。",
      "assets": [
        "m204-08538b11c2",
        "m204-7592970ada",
        "m204-near-far-sign-comparison"
      ],
      "points": [
        {
          "id": "choice",
          "title": "依現有牌面選擇適當的管制方式",
          "text": "現行遵行及禁行標誌未完整涵蓋所有行駛方向組合，應依路口實際允許或禁止的行向，選用適當的標誌牌面或組合，明確傳達管制內容。",
          "focus": {
            "asset": "m204-08538b11c2"
          }
        },
        {
          "id": "near",
          "title": "近端配置禁行及非橫向箭頭標誌",
          "text": "禁行方向標誌及非橫向箭頭的遵行方向標誌，原則配置於路口近端，使駕駛人在進入路口前即可辨識禁止或應遵循的行駛方向。",
          "focus": {
            "asset": "m204-near-far-sign-comparison"
          }
        },
        {
          "id": "far",
          "title": "遠端配置橫向箭頭標誌",
          "text": "橫向箭頭的遵行方向標誌可配置於路口遠端，讓駕駛人從上游接近時，能直觀辨識轉向方向，避免將橫向箭頭誤認為指示其他道路或出入口。",
          "focus": {
            "asset": "m204-near-far-sign-comparison"
          }
        }
      ],
      "sourcePages": [],
      "references": [
        "49",
        "61",
        "73",
        "74"
      ]
    },
    {
      "id": "m204-movement-extensions",
      "section": "module",
      "submoduleId": "M2-04.1",
      "title": "單行道出口銜接雙向道",
      "intro": "先讓駕駛看懂可行方向，再配合近、遠端位置表達限制。",
      "assets": [
        "m204-7592970ada"
      ],
      "points": [
        {
          "id": "warning",
          "title": "出口加強雙向來車提示",
          "text": "單行道出口順接雙向道時，可搭配雙向道標誌，提醒駕駛注意對向車流。"
        },
        {
          "id": "coordination",
          "title": "與單行道、停讓管制一起檢視",
          "text": "禁止進入標誌參照單行道子模組；讓路標誌參照停、讓管制模組。"
        }
      ],
      "sourcePages": [],
      "references": [
        "49",
