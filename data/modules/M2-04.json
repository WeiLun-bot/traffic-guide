        "m204-63819fd535",
        "m204-a2e842bf06"
      ],
      "points": [
        {
          "id": "near",
          "title": "近端表達非橫向的行駛方向",
          "text": "路口近端配置非橫向箭頭的道路遵行方向標誌，讓駕駛在進入前辨識。"
        },
        {
          "id": "far",
          "title": "遠端可增設橫向箭頭",
          "text": "必要時在遠端增設水平方向箭頭；已有對應單行道標誌時，可免重複設置。"
        },
        {
          "id": "restriction",
          "title": "禁止轉向資訊設於近端",
          "text": "路口近端清楚表達禁止左轉或右轉等限制，並與指向線及可行方向一致。"
        }
      ],
      "sourcePages": [],
      "references": [
        "49",
        "61",
        "73",
        "74"
      ]
    },
    {
      "id": "m204-movement-extensions",
      "section": "module",
      "submoduleId": "M2-04.1",
      "title": "單行道出口銜接雙向道",
      "intro": "先讓駕駛看懂可行方向，再配合近、遠端位置表達限制。",
      "assets": [
        "m204-7592970ada"
      ],
      "points": [
        {
          "id": "warning",
          "title": "出口加強雙向來車提示",
          "text": "單行道出口順接雙向道時，可搭配雙向道標誌，提醒駕駛注意對向車流。"
        },
        {
          "id": "coordination",
          "title": "與單行道、停讓管制一起檢視",
          "text": "禁止進入標誌參照單行道子模組；讓路標誌參照停、讓管制模組。"
        }
      ],
      "sourcePages": [],
      "references": [
        "49",
        "61",
        "73",
        "74"
      ]
    },
    {
      "id": "m204-island-issues",
      "section": "module",
      "submoduleId": "M2-04.2",
      "title": "交通島通行導引｜現況議題與相關條文",
      "intro": "以通行方向、高度與淨距，讓島頭位置更容易辨識。",
      "assets": [
        "m204-e6f9a94e50",
        "m204-55b65042db"
      ],
      "points": [
        {
          "id": "clearance",
          "title": "島頭標誌與車流淨距不足",
          "text": "靠右、靠左行駛標誌及分道標誌需保留橫向淨距，避免碰撞。"
        },
        {
          "id": "association",
          "title": "標誌高度與島頭不易對應",
          "text": "高度應配合駕駛視點，使標誌與交通島位置具有明確關聯。"
        }
      ],
      "sourcePages": [],
      "references": [
