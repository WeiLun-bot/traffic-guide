      ],
      "points": [
        {
          "id": "information",
          "title": "可搭配直接左轉告示",
          "text": "以行車指示性質告示牌說明機車可以直接左轉。"
        },
        {
          "id": "advance",
          "title": "車道預告可加入車種圖案",
          "text": "左轉方向可搭配車輛圖案，但應控制資訊量，讓駕駛能快速判讀。"
        }
      ],
