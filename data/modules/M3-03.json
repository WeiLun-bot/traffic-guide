    {
      "id": "m303-turning-diagram",
      "section": "module",
      "submoduleId": "M3-03.2",
      "title": "機車左轉｜圖例說明",
      "intro": "對照圖例，逐項檢視設施位置與配置方式。",
      "assets": [
        "m303-eb74f285de",
        "m303-6861b608fc",
        "m303-a5220c3ae3",
        "m303-87b5f62998"
      ],
      "points": [
        {
          "id": "speed",
          "title": "停等區設於適用的號誌化路口",
          "text": "機慢車停等區用於行車速限 60 km/h 以下、機車可行駛車道的停止線後方；非號誌化路口不得設置。"
        },
        {
          "id": "directions",
          "title": "不同轉向配合縮小型指向線",
          "text": "明確說明停等位置與方向，必要時與鄰近實線共用，避免重複劃線。"
        },
        {
          "id": "left",
          "title": "左轉附加車道可安排機車停等區",
          "text": "供左轉機車停等；直接左轉路口也可增設待轉區，供無法直接左轉的機車或自行車使用。"
        },
        {
          "id": "location",
          "title": "位置配合停止線及行穿線",
          "text": "待轉區設於停止線前端；與枕木紋行穿線至少間隔 50 cm，且不侵入交叉口實際範圍。"
        },
        {
          "id": "conditions",
          "title": "依號誌與車道條件安排",
          "text": "配合號誌管制及兩車道以上道路，提供兩段式左轉車輛明確的停等空間。"
        },
        {
          "id": "channel",
          "title": "以槽化線界定車流與待轉空間",
          "text": "避免直行車與進入待轉區的機車互相衝突。"
        },
        {
          "id": "bay",
          "title": "必要時採待轉停等彎",
          "text": "搭配路面邊線延伸線，明確引導車流與待轉車輛。"
        }
      ],
      "sourcePages": [],
      "references": [
        "65",
        "137",
        "174-2",
        "191"
      ]
    },
    {
      "id": "m303-turning-extensions",
