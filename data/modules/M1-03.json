    },
    {
      "id": "m103-parking-diagram",
      "section": "module",
      "submoduleId": "M1-03.1",
      "title": "路側停放與裝卸車位配置｜圖例說明",
      "intro": "透過停車格位配置、路口視距維護及停車資訊整合，明確區分行車與停車空間，提升停放秩序及交通安全。",
      "assets": [
        "m103-layout",
        "m103-plate-1",
        "m103-plate-2",
        "m103-plate-3"
      ],
      "points": [
        {
          "id": "buffer",
          "title": "停放線與路面邊線保留緩衝空間",
          "text": "車輛停放線與路面邊線建議間隔約 30 cm，以明確區分行車道與路側停車空間。間距由路面邊線中心量測至車輛停放線邊緣。"
        },
        {
          "id": "angle",
          "title": "依道路空間選擇停放角度",
          "text": "停車格位可依場地條件採 90°、45° 等不同角度配置，兼顧停車數量、車輛進出便利性及操作空間需求。"
        },
        {
          "id": "sight",
          "title": "路口附近優先配置機車停車位",
          "text": "接近路口處優先配置一般機車停車位，再往上游依序配置大型重型機車、小型車及大型客車停車位，減少較高車輛遮蔽路口視線的情形。"
        },
        {
          "id": "clearance",
          "title": "保留路口及出入口必要淨空",
          "text": "停車格位應與路口保持適當距離，並於轉角、漸變段及出入口配置禁止臨時停車線，避免停放車輛影響視距及車輛通行。"
        },
        {
          "id": "ends",
          "title": "以標誌及箭頭界定停車區間",
          "text": "停車處標誌原則設於停車帶起終點，配合箭頭標明適用範圍；停車帶較長時，可於中段加設標誌，方便駕駛人確認停放區間。"
        },
        {
          "id": "order",
          "title": "統一停車條件的資訊呈現",
          "text": "停放車種、時間及收費方式等資訊，原則透過附牌依「車種 → 時間 → 收費方式」排列；管制較複雜時，可整合為專用牌面，提升資訊辨識性。"
        }
      ],
      "sourcePages": [],
      "references": []
    },
    {
      "id": "m103-parking-extensions",
      "section": "module",
      "submoduleId": "M1-03.1",
      "title": "德國停車標誌實例",
      "intro": "把停車範圍與適用條件放在一起閱讀。",
      "assets": [
        "m103-germany"
      ],
      "points": [
        {
          "id": "range",
          "title": "以箭頭表達停車帶範圍",
          "text": "停車處標誌搭配起終點箭頭，對應實際停車帶位置。"
        },
        {
          "id": "conditions",
          "title": "同時說明車種與時段",
          "text": "透過附牌補充停放條件，方便用路人快速判讀。"
        }
      ],
      "sourcePages": [],
      "references": []
    },
