  "pages": [
    {
      "id": "m103-parking-issues",
      "section": "module",
      "submoduleId": "M1-03.1",
      "title": "路側停放與裝卸車位配置｜現況議題與相關條文",
      "intro": "路側停車不僅涉及停放空間的劃設，也影響行車動線、路口視距及停車管制資訊的辨識。",
      "defaultView": "single",
      "assets": [
        "m103-issue-street-parking",
        "m103-issue-parking-bays",
        "m103-issue-intersection-visibility"
      ],
      "points": [
        {
          "id": "boundary",
          "title": "行車與停車空間界線不明",
          "text": "車輛停放線與路面邊線未適當區隔，容易造成行車空間與停車空間界線混淆，影響駕駛人對道路空間的判讀。",
          "focus": {
            "asset": "m103-issue-parking-bays"
          }
        },
        {
          "id": "sight",
          "title": "停車格位配置影響路口視距",
          "text": "停車格位過於接近路口，或未考量不同車種的停放順序，可能使大型車輛遮蔽路口視線，影響駕駛人觀察交叉來車及行人的能力。",
          "focus": {
            "asset": "m103-issue-intersection-visibility"
          }
        },
        {
          "id": "consistency",
          "title": "停車範圍與管制資訊不明確",
          "text": "停車帶與禁止停車、禁止臨時停車區間界線不清，且停車處標誌未對應實際停放範圍，使駕駛人難以確認可停車區間及適用規則。",
          "focus": {
            "asset": "m103-issue-street-parking"
          }
        }
      ],
      "sourcePages": [],
