      "imageFit": "contain",
      "pointLinkedImages": true
    },
    {
      "id": "m401-local-diagram",
      "section": "module",
      "submoduleId": "M4-01.1",
      "title": "局部危險警示｜圖例說明",
      "intro": "依據道路接近速率、標誌可視性及駕駛人反應需求，配置局部危險警告標誌，使警示位置與實際危險處所明確對應。",
      "assets": [
        "m401-a614a49c08",
        "m401-cbdb2c7c69"
      ],
      "points": [
        {
          "id": "distance",
          "title": "依停車視距決定預告位置",
          "text": "警告標誌與危險標的物之間，原則保留 45～200 m 的停車視距，並依道路接近速率及實際視距條件調整，使駕駛人有足夠時間辨識及反應。",
          "focus": {
            "asset": "m401-a614a49c08"
          }
        },
        {
          "id": "relation",
          "title": "明確對應危險處所位置",
          "text": "隧道標誌應以隧道洞口、狹橋標誌應以狹橋端點作為警告標的物，避免標誌距離過近或過遠，影響駕駛人對實際危險位置的判斷。",
          "focus": {
            "asset": "m401-cbdb2c7c69"
          }
        },
        {
          "id": "visibility",
          "title": "確保標誌可視性與反應距離",
          "text": "檢核道路線形、植栽及其他設施對標誌視認的影響，確保駕駛人在到達危險處所前，能完成必要的減速與停等準備。",
          "focus": {
            "asset": "m401-a614a49c08"
          }
        }
      ],
      "sourcePages": [],
      "references": [
        "24–55-2",
        "29",
        "48"
      ],
      "imageFit": "contain"
    },
    {
      "id": "m401-local-extensions",
      "section": "module",
      "submoduleId": "M4-01.1",
      "title": "隧道入口的警告與管制",
      "intro": "在到達局部危險處所前，提供看得見、來得及反應的警告。",
      "assets": [
        "m401-a614a49c08"
      ],
      "points": [
        {
          "id": "approach",
          "title": "在到達洞口前完成準備",
          "text": "依接近速率、視距與遮蔽條件安排預告位置。"
        },
        {
          "id": "restriction",
          "title": "警告與通行限制分工",
          "text": "限高、限寬或車種限制的起點與改道資訊，參照通行限制模組一起檢查。"
        }
      ],
      "sourcePages": [],
      "references": [
        "24–55-2",
        "48",
        "29"
      ]
    },
    {
      "id": "m401-local-extension-bridge",
      "section": "module",
      "submoduleId": "M4-01.1",
      "title": "狹橋端點的警告與管制",
      "intro": "在到達局部危險處所前，提供看得見、來得及反應的警告。",
      "assets": [
        "m401-cbdb2c7c69"
      ],
      "points": [
        {
          "id": "approach",
          "title": "警告位置對應狹橋端點",
          "text": "讓駕駛在進橋前辨識道路條件變化，配合所需反應與停等距離。"
        },
        {
          "id": "coordination",
          "title": "與會車、限重等設施協調",
          "text": "依橋梁條件搭配管制，維持警告位置與實際限制的一致性。"
        }
      ],
      "sourcePages": [],
      "references": [
        "24–55-2",
        "48",
        "29"
      ]
    },
    {
      "id": "m401-road-issues",
      "section": "module",
      "submoduleId": "M4-01.2",
      "title": "路段危險警示｜現況議題與相關條文",
      "intro": "危險彎道路段除須提前警告駕駛人外，亦應持續提供道路線形及危險範圍資訊，使駕駛人能依實際道路條件調整行駛速度。",
      "assets": [
        "m401-road-issue-photo-1"
      ],
      "points": [
        {
          "id": "continuity",
          "title": "危險彎道的走向與持續範圍不易辨識",
          "text": "若僅於路段起點設置警告標誌，缺乏沿線方向導引或危險範圍提示，可能使駕駛人無法預期後續彎道，或通過第一處彎道後過早加速；反之，過度重複設置警告標誌，也可能增加駕駛人的資訊負擔。",
          "focus": {
            "asset": "m401-road-issue-photo-1"
          }
        }
      ],
      "sourcePages": [],
      "references": [
        "24",
        "25",
        "134"
      ],
      "applications": [
        "C4-06"
      ],
      "defaultView": "single",
      "imageFit": "contain",
      "pointLinkedImages": true
    },
    {
      "id": "m401-road-diagram",
      "section": "module",
      "submoduleId": "M4-01.2",
      "title": "路段危險警示｜圖例說明",
      "intro": "依危險彎道的線形及辨識需求，配置安全方向導引標誌與彎路警告標誌，結合沿線導引、上游預告及危險範圍提示。",
      "assets": [
        "m401-a6bae42a3b"
      ],
      "points": [
        {
          "id": "need",
          "title": "依彎道辨識需求決定設置時機",
          "text": "當駕駛人無法及時看清後續彎道走向，或彎道曲率明顯超出上游路段的行車預期時，應考量設置安全方向導引標誌；較緩和且容易辨識的彎道則不必一律設置。",
          "focus": {
            "asset": "m401-a6bae42a3b"
          }
        },
        {
          "id": "visibility",
          "title": "沿彎道配置連續的方向導引",
          "text": "彎道中至少設置 3 面安全方向導引標誌，並建議使駕駛人於入彎前及彎道中隨時可見至少 2 面，持續掌握後續道路走向。",
          "focus": {
            "asset": "m401-a6bae42a3b"
          }
        },
        {
          "id": "spacing",
          "title": "依彎道曲率調整設置間距",
          "text": "同一曲率路段的標誌宜均勻配置；若彎道曲率有所變化，應於曲率半徑較小處加密設置。直線路段間的短距離明顯轉折，亦可使用合併式安全方向導引標誌。",
          "focus": {
            "asset": "m401-a6bae42a3b"
          }
        },
        {
          "id": "criteria",
          "title": "依彎道條件增設上游警告",
          "text": "危險彎道已適當設置安全方向導引標誌後，若曲線半徑及視距符合彎路標誌的設置條件，應於上游增設對應方向的彎路標誌，建議距危險彎道 150～250 m，以提供駕駛人反應時間。",
          "focus": {
            "asset": "m401-a6bae42a3b"
          }
        },
        {
          "id": "range",
          "title": "以連續彎路標誌表達危險範圍",
          "text": "當道路具有連續危險彎道，或連續彎道中穿插危險彎道時，應設置連續彎路標誌及適用範圍附牌，並使標誌圖案對應第一處危險彎道方向。",
          "focus": {
            "asset": "m401-a6bae42a3b"
          }
        },
        {
          "id": "distance",
          "title": "整合上游預告與沿線方向導引",
          "text": "彎路或連續彎路標誌應與安全方向導引標誌相互配合，避免警告資訊重複或不一致，並檢核由中途道路進入的駕駛人是否能取得必要的警示資訊。",
          "focus": {
            "asset": "m401-a6bae42a3b"
          }
        }
      ],
      "sourcePages": [],
      "references": [
        "24",
        "25",
        "134"
      ],
      "defaultView": "single",
      "imageFit": "contain"
    },
