        "81",
        "82",
        "83"
      ]
    },
    {
      "id": "m402-restriction-extension-width",
      "section": "module",
      "submoduleId": "M4-02.1",
      "title": "限寬數值與安全淨寬",
      "intro": "把限制條件、改道準備與實際管制起點一起說清楚。",
      "assets": [
        "m402-ae32e39564"
      ],
      "points": [
        {
          "id": "width",
          "title": "結構寬度扣除兩側安全餘裕",
          "text": "圖例以兩側各保留 0.25 m 作為示例；實際數值依現地可通行空間檢核。"
        }
      ],
