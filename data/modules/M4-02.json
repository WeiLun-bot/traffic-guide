  "pages": [
    {
      "id": "m402-restriction-issues",
      "section": "module",
      "submoduleId": "M4-02.1",
      "title": "車種與通行條件限制｜現況議題與相關條文",
      "intro": "車種、限重、限寬及限高等通行限制，應整合管制起點、上游預告與改道需求，並使限制數值符合實際可通行空間。",
      "assets": [
        "m402-restriction-issue-photo-1"
      ],
      "points": [
        {
          "id": "exit",
          "title": "管制起點未兼顧改道與沿線通達需求",
          "text": "若僅於橋涵、隧道等瓶頸前設置限制標誌，受限車輛可能已無適當空間迴轉或改道；若過度提前管制，則可能不必要地限制沿線目的地的通達。",
          "focus": {
            "asset": "m402-restriction-issue-photo-1"
          }
        },
        {
          "id": "values",
          "title": "限制數值與實際可通行空間不符",
          "text": "限高、限寬等限制若未依實際結構尺寸及必要安全餘裕檢核，可能使標誌所示的通行條件與道路實際可通行空間不符，影響車輛通行安全。",
          "focus": {
            "asset": "m402-restriction-issue-photo-1"
          }
        }
      ],
      "sourcePages": [],
      "references": [
        "61",
        "73",
        "74",
        "81",
        "82",
        "83"
      ],
      "applications": [
        "G1-06",
        "C1-01",
        "C2-02"
      ],
      "defaultView": "single",
      "imageFit": "contain",
      "pointLinkedImages": true
    },
    {
      "id": "m402-restriction-diagram",
      "section": "module",
      "submoduleId": "M4-02.1",
      "title": "車種與通行條件限制｜圖例說明",
      "intro": "依據實際限制位置、受限車輛改道需求及道路可通行條件，配置限制標誌與上游導引資訊，使駕駛人能提前辨識並選擇適當行駛路徑。",
      "assets": [
        "m402-b18c7d1f2f",
        "m402-ae32e39564"
      ],
      "points": [
        {
          "id": "start",
          "title": "區分實際管制起點與上游預告",
          "text": "車種及通行條件限制原則設於實際限制起點；若需提前提醒駕駛人，應搭配距離附牌或告示牌，明確區分上游預告位置與實際管制起點。",
          "focus": {
            "asset": "m402-b18c7d1f2f"
          }
        },
        {
          "id": "exceptions",
          "title": "依改道與沿線通達需求調整限制起點",
          "text": "當瓶頸前缺乏適當迴轉空間，或車輛進入後無法退出，且不影響沿線必要目的地通達時，可將限制起點提前至適當位置，避免車輛進入後無法安全改道。",
          "focus": {
            "asset": "m402-ae32e39564"
          }
        },
        {
          "id": "vehicle",
          "title": "於各接近方向提供車種與行向資訊",
          "text": "當車種限制設於路口下游時，應於各接近方向配合設置遵行方向標誌，並於牌面加入受限車種圖案，使駕駛人在進入路口前即可辨識可行駛方向。",
          "focus": {
            "asset": "m402-b18c7d1f2f"
          }
        },
        {
          "id": "height",
          "title": "依實際高度與安全淨高檢核限高數值",
          "text": "限高數值應以車輛可行駛寬度範圍內的實際高度為基礎，扣除必要安全淨高；本指引以 0.20～0.50 m 作為安全餘裕的檢討示例。",
          "focus": {
            "asset": "m402-b18c7d1f2f"
          }
        },
        {
          "id": "width",
          "title": "依結構寬度與兩側淨寬檢核限寬數值",
          "text": "限寬數值應由實際結構寬度扣除兩側必要安全淨寬；本指引以兩側各保留 0.25 m 為示例，確保標示數值與可通行空間相符。",
          "focus": {
            "asset": "m402-ae32e39564"
          }
        }
      ],
      "sourcePages": [],
      "references": [
        "61",
        "73",
        "74",
        "81",
        "82",
        "83"
      ],
      "imageFit": "contain"
    },
    {
      "id": "m402-restriction-extensions",
      "section": "module",
      "submoduleId": "M4-02.1",
      "title": "限高數值與安全淨高",
      "intro": "把限制條件、改道準備與實際管制起點一起說清楚。",
      "assets": [
        "m402-b18c7d1f2f"
      ],
      "points": [
        {
          "id": "height",
          "title": "以可行駛寬度對應的高度計算",
          "text": "限高值由實際可通行高度扣除安全淨高；圖例以 0.20–0.50 m 安全餘裕作為檢討示例。"
        },
        {
          "id": "units",
          "title": "牌面單位保持一致",
          "text": "單位代號可參照法定度量衡單位使用指南。"
        }
      ],
      "sourcePages": [],
      "references": [
        "61",
