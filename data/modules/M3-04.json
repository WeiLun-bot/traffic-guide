    {
      "id": "m304-lane-issues",
      "section": "module",
      "submoduleId": "M3-04.1",
      "title": "公車專用道｜現況議題與相關條文",
      "intro": "公車專用道應透過連續且明確的車道配置、進出動線及交通管制設施，降低一般車流干擾，並確保公車行駛安全與運行效率。",
      "defaultView": "pair",
      "assets": [
        "m304-lane-issue-photo-1",
        "m304-lane-issue-photo-2"
      ],
      "points": [
        {
          "id": "paths",
          "title": "交通島配置未配合公車行駛軌跡",
          "text": "公車車身較長、轉向所需空間較大，若路口交通島未配合公車行駛軌跡及動態包絡範圍設計，可能造成公車輾壓島頭，或為避開交通島而提前偏移車道。"
        }
      ],
      "sourcePages": [],
      "references": [
        "69",
        "73-1",
        "74",
        "167",
        "171",
        "174",
        "175",
        "189"
      ],
      "applications": [
        "G1-03",
        "G1-01",
        "G4-01",
        "G4-03",
        "C4-03"
      ],
      "referenceNames": {
        "74": "禁行方向標誌"
      }
    },
    {
      "id": "m304-lane-diagram",
      "section": "module",
      "submoduleId": "M3-04.1",
      "title": "公車專用道｜圖例說明",
      "intro": "依公車行駛軌跡及專用道進出需求，整合槽化線、車道管制標線與標誌，確保公車行駛動線連續，並明確區分公車專用道與一般車道的通行空間。",
      "assets": [
        "m304-55a30512cf",
        "m304-4ce4616de6"
      ],
      "points": [
        {
          "id": "channel",
          "title": "以槽化線提供軌跡修正空間",
          "text": "公車專用道接近路口時，可將部分實體交通島改以槽化線過渡，保留公車行駛或轉向所需的緩衝及軌跡修正空間。",
          "focus": {
            "asset": "m304-4ce4616de6"
          }
        },
        {
          "id": "envelope",
          "title": "依公車動態包絡範圍檢核島頭位置",
          "text": "透過公車行駛軌跡模擬，檢核交通島與公車通行空間的關係，避免公車輾壓島頭，或為閃避交通島而提前偏移車道。",
          "focus": {
            "asset": "m304-4ce4616de6"
          }
        },
        {
          "id": "entry",
          "title": "以單邊禁止變換車道線引導匯入與匯出",
          "text": "於公車專用道進出端配置單邊禁止變換車道線。上游起點公車道側為實線、一般車道側為虛線，提供公車匯入；接近路口時則反向配置，公車道側為虛線、一般車道側為實線，提供專用道車輛匯出空間。",
          "focus": {
            "asset": "m304-55a30512cf"
          }
        },
        {
          "id": "bus",
          "title": "以標誌標線明確指示專用道位置",
          "text": "於專用道起點設置車道指定大客車專行標誌（遵28），箭頭應對準專用道中央，並配合車種專用車道標線及標字，使駕駛人清楚辨識專用道範圍，避免一般車輛誤入。",
          "focus": {
            "asset": "m304-55a30512cf"
          }
        },
        {
          "id": "wrong-way",
          "title": "視道路型態防止逆向誤入",
          "text": "於無中央分隔或單行道等容易誤判車道方向的環境，可增設車道禁止進入標誌（禁16），避免車輛逆向進入對向公車專用道。",
          "focus": {
            "asset": "m304-55a30512cf"
          }
        }
      ],
      "sourcePages": [],
      "references": [
        "69",
        "73-1",
        "74",
        "167",
        "171",
        "174",
        "175",
        "189"
      ],
      "defaultView": "single",
      "imageFit": "contain"
    },
    {
      "id": "m304-lane-extensions",
      "section": "module",
      "submoduleId": "M3-04.1",
      "title": "內側公車專用道的轉向管制",
      "intro": "從進出端、島頭到路口轉向，維持公車專用道的清楚辨識。",
      "assets": [],
      "points": [
        {
          "id": "left",
          "title": "依是否允許公車左轉選用標誌",
          "text": "允許左轉時不設禁左；不允許時設禁左，原則不另加附牌，除非有誤認疑慮。"
        },
        {
          "id": "right",
          "title": "右轉限制與直行方向一起檢視",
          "text": "專用道設禁止右轉；同時禁止左轉時，可採僅准直行，特殊時段性限制另行說明。"
        }
      ],
      "sourcePages": [],
      "references": [
        "69",
        "73-1",
        "74",
        "167",
        "171",
        "174",
        "175",
        "189"
      ]
    },
    {
      "id": "m304-lane-extension-outer",
      "section": "module",
      "submoduleId": "M3-04.1",
      "title": "外側車道的轉向管制",
      "intro": "從進出端、島頭到路口轉向，維持公車專用道的清楚辨識。",
      "assets": [],
      "points": [
        {
          "id": "allowed",
          "title": "所有車輛都可左轉時",
          "text": "不設禁止左轉標誌。"
        },
        {
          "id": "bus-only",
          "title": "僅允許公車左轉時",
          "text": "設禁止左轉標誌並加「公車除外」附牌。"
        },
        {
          "id": "prohibited",
          "title": "全部禁止左轉時",
          "text": "設禁止左轉標誌，原則不加附牌；指向線同步配合管制。"
        }
      ],
