    {
      "id": "m304-stop-issues",
      "section": "module",
      "submoduleId": "M3-04.2",
      "title": "公車路側停靠站｜現況議題與相關條文",
      "intro": "公車路側停靠站應提供足夠的停靠及進出空間，並透過明確的標線導引公車靠站與離站，維持乘客上下車及周邊車流安全。",
      "assets": [
        "m304-stop-issue-photo-1"
      ],
      "points": [
        {
          "id": "space",
          "title": "公車停靠空間與進出動線配置不當",
          "text": "公車停靠區長度、前後進出空間不足，或缺乏明確的標線導引，可能使公車無法貼近路緣停靠，或需提前偏移、跨越鄰近車道修正行駛軌跡，影響乘客上下車及其他車流安全。",
          "focus": {
            "asset": "m304-stop-issue-photo-1"
          }
        }
      ],
      "sourcePages": [],
      "references": [
        "169",
        "171",
        "183",
        "189-1"
      ],
      "applications": [
        "G1-03",
