  "pages": [
    {
      "id": "m202-roundabout-issues",
      "section": "module",
      "submoduleId": "M2-02.1",
      "title": "無號誌圓環｜現況議題與相關條文",
      "intro": "圓環藉由環內優先及車流軌跡控制，降低路口交會衝突，惟入口管制與行車導引不明確，仍可能影響通行秩序及安全。",
      "assets": [
        "m202-roundabout-issue-photo-1"
      ],
      "points": [
        {
          "id": "priority",
          "title": "環內車輛優先關係不明確",
          "text": "圓環入口缺乏讓路標誌、讓路線，或相關標誌設置位置不一致，使駕駛人難以辨識環內車輛具有優先通行權，容易發生環內外車輛爭道。",
          "focus": {
            "asset": "m202-roundabout-issue-photo-1"
          }
        },
        {
          "id": "entry",
          "title": "入口行駛軌跡缺乏適當控制",
          "text": "圓環入口幾何配置不當，或缺乏分隔島及標線導引，可能使車輛以過於直順的軌跡駛入圓環，難以有效控制入環速度。",
          "focus": {
            "asset": "m202-roundabout-issue-photo-1"
          }
        },
        {
          "id": "exit",
          "title": "環內車道與出口缺乏連續導引",
          "text": "環內車道標線與出口銜接關係不明確，駕駛人難以提前掌握行駛路徑，可能發生臨時變換車道、切入出口或不必要減速，影響環內行車秩序。",
          "focus": {
            "asset": "m202-roundabout-issue-photo-1"
          }
        }
      ],
      "sourcePages": [],
      "references": [
        "34",
        "59",
        "66",
        "171",
        "172",
        "189"
      ],
      "applications": [
        "C1-07",
        "C1-08"
      ],
      "defaultView": "single",
      "pointLinkedImages": true
    },
    {
      "id": "m202-roundabout-diagram",
      "section": "module",
      "submoduleId": "M2-02.1",
      "title": "無號誌圓環｜圖例說明",
      "intro": "透過入口讓路管制、行駛軌跡控制及環內動線導引，明確建立優先關係，讓車輛以適當速度進入圓環並順利駛離。",
      "assets": [
        "m202-roundabout"
      ],
      "points": [
        {
          "id": "yield-line",
          "title": "以讓路線明確標示入環讓路位置",
          "text": "於圓環入口劃設讓路線，使雙白虛線與路口行車導引線對齊，明確標示車輛進入圓環前的讓路位置，提醒駕駛人觀察並讓行環內車輛。",
          "focus": {
            "asset": "m202-roundabout"
          }
        },
        {
          "id": "direction",
          "title": "整合讓路與圓環遵行方向標誌",
          "text": "圓環遵行方向標誌原則設於圓環外緣、入口右側，並於上方設置讓路標誌，明確傳達圓環行駛方向及環內車輛優先通行的規定。",
          "focus": {
            "asset": "m202-roundabout"
          }
        },
        {
          "id": "channel",
          "title": "透過入口幾何控制入環速度",
          "text": "配合中央島、入口曲率及分隔島配置，使車輛進入圓環時形成適當的行駛軌跡偏轉，避免以過於直順的路徑高速駛入。",
          "focus": {
            "asset": "m202-roundabout"
          }
        },
        {
          "id": "channel-path",
          "title": "以槽化線引導入口行駛路徑",
          "text": "配合入口分隔島及車道線形配置槽化線，協助駕駛人提前辨識島頭位置及行駛路徑，依循既定軌跡進入圓環。",
          "focus": {
            "asset": "m202-roundabout"
          }
        },
        {
          "id": "curvature",
          "title": "兼顧入口與出口的行駛曲率",
          "text": "入口速度控制不應僅以道路中心線偏移程度判斷，應同時考量入口及出口的行駛軌跡，避免改善入口偏轉時，反而使出口過於直順。",
          "focus": {
            "asset": "m202-roundabout"
          }
        },
        {
          "id": "guide",
          "title": "明確標示環內行駛邊界",
          "text": "透過路口行車導引線延伸道路邊界，協助駕駛人辨識環內行駛範圍與車道位置，維持清楚的行車軌跡。",
          "focus": {
            "asset": "m202-roundabout"
          }
        },
        {
          "id": "exit",
          "title": "引導環內車輛銜接出口",
          "text": "使環內標線與出口車道相互對應，協助駕駛人提前掌握出口位置與行駛動線，減少臨時變換車道及切入出口的情形。",
          "focus": {
            "asset": "m202-roundabout"
          }
        }
      ],
      "sourcePages": [],
      "references": [],
      "notice": "本圖僅示意一處入口，其餘入口比照配置。"
    },
    {
      "id": "m202-roundabout-extensions",
      "section": "module",
      "submoduleId": "M2-02.1",
      "title": "無號誌圓環｜延伸應用",
      "intro": "透過圖形化地名方向指示標誌，提前呈現圓環出口方向與目的地資訊，協助駕駛人辨識行駛路徑。",
      "assets": [
        "m202-roundabout-directions"
      ],
      "points": [
        {
          "id": "exits",
          "title": "以圖形化牌面預告出口方向",
          "text": "透過圓環圖形呈現各出口位置及可通往的目的地，讓駕駛人在入環前掌握出口方向，降低臨時判斷行駛路徑的負擔。",
          "focus": {
            "asset": "m202-roundabout-directions"
          }
        },
        {
          "id": "geometry",
          "title": "配合實際路型設計指示資訊",
          "text": "標誌圖形應對應圓環形狀、出口數量及道路配置，並設於入口上游適當位置，提供足夠的辨識與反應時間。",
          "focus": {
            "asset": "m202-roundabout-directions"
          }
        },
        {
          "id": "lanes",
          "title": "整合車道選擇與目的地資訊",
          "text": "多車道或渦輪圓環可進一步結合車道配置與出口方向資訊，協助駕駛人於入環前選擇正確車道，減少環內臨時變換車道的需求。",
          "focus": {
            "asset": "m202-roundabout-directions"
          }
        }
      ],
      "sourcePages": [],
      "references": []
    }
  ],
