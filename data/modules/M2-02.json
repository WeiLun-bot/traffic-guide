      "section": "module",
      "submoduleId": "M2-02.1",
      "title": "無號誌圓環｜現況議題與相關條文",
      "intro": "建立環內優先，讓入口、環內與出口的動線連續。",
      "assets": [
        "m202-roundabout"
      ],
      "points": [
        {
          "id": "priority",
          "title": "環內優先不夠明確",
          "text": "入口缺少讓路標誌、讓路線，或方向標誌位置不一致，容易發生環內外車輛爭道。"
        },
        {
          "id": "entry",
          "title": "入口偏移與分隔島不易辨識",
          "text": "缺少明確導引時，駕駛難以提早掌握車道偏移與島頭位置。"
        },
        {
          "id": "exit",
          "title": "環內導引與出口銜接不足",
          "text": "動線不連續可能造成臨時換道、切入出口或不必要減速。"
        }
      ],
      "sourcePages": [],
      "references": [
        "34",
        "59",
        "66",
        "171",
        "172",
        "189"
      ],
      "applications": [
        "C1-07",
        "C1-08"
      ]
    },
    {
      "id": "m202-roundabout-diagram",
      "section": "module",
      "submoduleId": "M2-02.1",
      "title": "無號誌圓環｜圖例說明",
      "intro": "各入口以一致方式，搭配讓路、方向標誌與標線導引。",
      "assets": [
        "m202-roundabout"
      ],
      "points": [
        {
          "id": "yield-line",
          "title": "讓路線建立環內優先",
          "text": "入口讓路線搭配讓路標誌；雙白虛線與行車導引線對齊，提醒駕駛注意環內車流。"
        },
        {
          "id": "channel",
          "title": "槽化線配合分隔島與車道偏移",
          "text": "提早呈現入口島頭與車道偏移，讓車輛沿清楚的軌跡進入圓環。"
        },
        {
          "id": "guide",
          "title": "導引線連續提示環內邊界與出口",
          "text": "以路口行車導引線延伸主要道路邊線，協助駕駛辨識環內路徑及出口位置。"
        },
        {
          "id": "direction",
          "title": "方向標誌設於一致位置",
          "text": "原則設於圓環外緣、臨近入口右側；必要時可增設於交通島或入口左側。"
        },
        {
          "id": "yield-sign",
          "title": "讓路標誌設於方向標誌上方",
          "text": "再次提醒進入圓環的車輛，讓環內車輛優先通行。"
        },
        {
          "id": "advance",
          "title": "視距不足或車速較高時提前預告",
          "text": "可在入口上游設置圓環標誌，讓駕駛及早辨識圓環並準備減速。"
        }
      ],
      "sourcePages": [],
      "references": [],
      "notice": "本圖僅示意一處入口，其餘入口比照配置。"
    },
    {
      "id": "m202-roundabout-extensions",
      "section": "module",
      "submoduleId": "M2-02.1",
      "title": "無號誌圓環｜延伸應用",
      "intro": "多車道與行人穿越需求，一併納入圓環配置。",
      "assets": [],
      "points": [
        {
          "id": "arrows",
          "title": "多車道入口加設指向線",
          "text": "進入多車道圓環前佈設一組指向線，說明各車道的行駛方向。"
        },
        {
          "id": "crosswalk",
          "title": "行穿線銜接禁臨停線",
          "text": "枕木紋行穿線與禁止臨時停車線同時設置時，由行穿線截斷禁臨停線。"
        },
        {
          "id": "refuge",
          "title": "提供行人庇護空間",
          "text": "可增設行人庇護島，提供分段穿越空間，並提醒駕駛注意行人。"
        },
        {
          "id": "distance",
          "title": "停止線與行穿線保留淨距",
          "text": "設有枕木紋行穿線時，停止線與其淨距為 1–3 m。"
        }
      ],
      "sourcePages": [],
      "references": []
    }
