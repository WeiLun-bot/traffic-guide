          ]
        }
      }
    },
    {
      "id": "m101-lanes-issues",
      "section": "module",
      "submoduleId": "M1-01.1",
      "title": "路口與路段車道配置｜現況議題與相關條文",
      "intro": "從車道連續性與轉向軌跡，檢查路段如何銜接路口。",
      "defaultView": "pair",
      "assets": [
        "m101-issue-junction",
        "m101-issue-road-section"
      ],
      "points": [
        {
          "id": "continuity",
          "title": "車道用途前後不連續",
          "text": "路段車道若未配合轉向需求，駕駛到路口前才會發現需要換道。"
        },
        {
          "id": "path",
          "title": "導引線未配合實際軌跡",
          "text": "轉彎路徑若未檢核，車輛可能無法沿線行駛，甚至偏向交通島。"
        },
        {
          "id": "review",
          "title": "一併檢視路段與路口",
          "text": "從車道配置、轉向軌跡到下游出口，一起確認動線是否連續。"
        }
      ],
      "sourcePages": [],
      "references": [
        "133-1",
        "171",
        "183-1",
        "184",
        "188",
        "189",
        "189-1"
      ],
      "applicationNote": "通用模組，適用於各類道路情境。"
    },
    {
      "id": "m101-lanes-diagram",
      "section": "module",
      "submoduleId": "M1-01.1",
      "title": "路口與路段車道配置｜圖例說明",
      "intro": "以標線與預告標誌，逐步說清楚各方向的車道與行進路徑。",
      "assets": [
        "m101-lanes"
      ],
      "points": [
        {
          "id": "dotted-width",
          "title": "穿越虛線區分直行與轉向",
          "text": "匯入主線建議採 15 cm 寬；匯出主線建議採 30 cm 寬，加強交織提示。",
          "focus": {
            "asset": "m101-lanes",
            "rect": [
              420,
              398,
              620,
              106
            ]
          }
        },
        {
          "id": "dotted-length",
          "title": "從漸變區引導至專用車道",
          "text": "穿越虛線由漸變區起點延伸至專用車道起點；左右轉專用道進入路口前 20 m 搭配禁止變換車道線。",
          "focus": {
            "asset": "m101-lanes",
            "rect": [
              370,
              398,
              650,
              112
            ]
          }
        },
        {
          "id": "arrows",
          "title": "指向線分組預告",
          "text": "第一組設於停止線或機慢車停等區外邊界上游 2–5 m；第二組再往上游 20 m，其後各組間隔 20–60 m。",
          "focus": {
            "asset": "m101-lanes",
            "rect": [
              500,
              400,
              500,
              115
            ]
          }
        },
        {
          "id": "advance",
          "title": "車道漸變前先預告",
          "text": "在漸變區上游設置車道預告標誌，讓駕駛提早選擇車道。",
          "focus": {
            "asset": "m101-lanes",
            "rect": [
              370,
              495,
              70,
              115
            ]
          }
        },
        {
          "id": "guide-width",
          "title": "轉彎後車道寬度改變",
          "text": "下游過寬或過窄時，以導引線標示轉彎軌跡，銜接正確車道。",
          "focus": {
            "asset": "m101-lanes",
            "rect": [
              1090,
              290,
              270,
              280
            ]
          }
        },
        {
          "id": "guide-offset",
          "title": "直行偏移與主線方向不清",
          "text": "直行車道偏移、偏斜或多岔路口，可用導引線提示連續的主要路徑。",
          "focus": {
            "asset": "m101-lanes",
            "rect": [
              1070,
              315,
              310,
              220
            ]
          }
        },
        {
          "id": "guide-overlap",
          "title": "導引線重疊時適度簡化",
          "text": "優先保留容易誤判的關鍵流向；其他導引線可截斷或省略，避免過於複雜。",
          "focus": {
            "asset": "m101-lanes",
            "rect": [
              1140,
              350,
              160,
              155
            ]
          }
        },
        {
          "id": "channel",
          "title": "槽化多餘空間",
          "text": "以槽化線界定禁止通行區域，區隔車流並順化轉彎軌跡。",
          "focus": {
            "asset": "m101-lanes",
            "rect": [
              1110,
              485,
              150,
              85
            ]
          }
        },
        {
          "id": "waiting",
          "title": "左彎待轉區避開其他動線",
          "text": "依轉彎軌跡安排線形與停等位置，避免影響對向左轉及直行車流。",
          "focus": {
            "asset": "m101-lanes",
            "rect": [
              1095,
              355,
              90,
              85
            ]
          }
        }
      ],
      "sourcePages": [],
      "references": []
    },
    {
      "id": "m101-lanes-extensions",
      "section": "module",
      "submoduleId": "M1-01.1",
      "title": "慢車道與一般車道同寬",
      "intro": "在路口銜接處，讓車種分隔配合轉向需求。",
      "assets": [
        "m101-slow-wide"
      ],
      "points": [
        {
          "id": "right-turn",
          "title": "讓右轉車提早就位",
          "text": "慢車道較寬時，可延續快慢車道分隔線；右轉車依規定提前進入慢車道。"
        },
        {
          "id": "lane-line",
          "title": "必要時改以車道線提示",
          "text": "近路口處可將快慢車道分隔線改為車道線，提示右轉車先進入最外側車道。"
        }
      ],
      "sourcePages": [],
      "references": []
    },
    {
      "id": "m101-lanes-narrow",
      "section": "module",
      "submoduleId": "M1-01.1",
      "title": "窄慢車道銜接路口",
      "intro": "由車種分隔轉為方向分隔，減少路口前的交織。",
      "assets": [
        "m101-slow-narrow"
      ],
      "points": [
        {
          "id": "transition",
          "title": "2.8 m（含）以下先調整配置",
          "text": "在路口前 30–60 m 中斷慢車道配置，配合分流式指向線引導各方向車流。"
        },
        {
          "id": "width",
          "title": "過寬空間以槽化調整",
          "text": "非實體分隔的最外側車道不宜大於 4.5 m；原車道與慢車道合計過寬時，可用槽化縮減。"
        },
        {
          "id": "warning",
          "title": "車道縮減要提前提示",
          "text": "必要時加設車道、路寬縮減標誌，提醒慢車道車流向左銜接下游外側車道。"
        }
      ],
      "sourcePages": [],
      "references": []
    },
    {
      "id": "m101-additional-issues",
      "section": "module",
      "submoduleId": "M1-01.2",
      "title": "附加車道｜現況議題與相關條文",
      "intro": "附加車道除了要放得下，也要讓駕駛看得懂、來得及進入。",
      "assets": [
        "m101-additional-issue-photo"
      ],
      "points": [
        {
          "id": "recognition",
          "title": "車道變化不易提早辨識",
          "text": "標線與預告不完整，駕駛可能到路口前才察覺轉向車道。"
        },
        {
          "id": "storage",
          "title": "漸變或儲車空間不足",
          "text": "轉向車流無法順暢進入，排隊可能外溢並影響主線直行車流。"
        },
        {
          "id": "consistency",
          "title": "幾何與導引一起檢視",
          "text": "同時確認漸變長度、儲車空間、車道連續性與標誌標線的一致性。"
        }
      ],
      "sourcePages": [],
