  "pages": [
    {
      "id": "m101-overview",
      "section": "module",
      "title": "M1-01 路口動線導引",
      "intro": "讓路段車道、路口轉向與下游車道連成清楚的行車路徑。",
      "assets": [
        "m101-lanes",
        "m101-additional"
      ],
      "points": [
        {
          "id": "layout",
          "title": "M1-01.1 路口與路段車道配置",
          "text": "搭配穿越虛線、指向線與行車導引線，說明車道用途及行進路徑。",
          "submoduleId": "M1-01.1"
        },
        {
          "id": "additional",
          "title": "M1-01.2 附加車道",
          "text": "檢視漸變長度、儲車空間與預告導引，讓轉向車流提早分流。",
          "submoduleId": "M1-01.2"
        }
      ],
      "sourcePages": [],
      "references": [],
      "mode": "pair",
      "excludedOverviewPointIds": [
        "continuity"
      ],
      "overviewGroups": {
        "M1-01.1": {
          "assets": [
            "m101-lanes"
          ]
        },
        "M1-01.2": {
          "assets": [
