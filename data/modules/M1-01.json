  "pages": [
    {
      "id": "m101-overview",
      "section": "module",
      "title": "M1-01 車道動線導引",
      "intro": "讓路段車道、路口轉向與下游車道連成清楚的行車路徑。",
      "assets": [
        "m101-lanes",
        "m101-additional"
      ],
      "points": [
        {
          "id": "layout",
          "title": "M1-01.1 路口與路段車道配置",
          "text": "搭配穿越虛線、指向線與行車導引線，說明車道用途及行進路徑。",
          "submoduleId": "M1-01.1"
        },
        {
          "id": "additional",
          "title": "M1-01.2 附加車道",
          "text": "檢視漸變長度、儲車空間與預告導引，讓轉向車流提早分流。",
          "submoduleId": "M1-01.2"
        }
      ],
      "sourcePages": [],
      "references": [],
      "mode": "pair",
      "excludedOverviewPointIds": [
        "continuity"
      ],
      "overviewGroups": {
        "M1-01.1": {
          "assets": [
            "m101-lanes"
          ]
        },
        "M1-01.2": {
          "assets": [
            "m101-additional"
          ]
        }
      }
    },
    {
      "id": "m101-lanes-issues",
      "section": "module",
      "submoduleId": "M1-01.1",
      "title": "路口與路段車道配置｜現況議題與相關條文",
      "intro": "從車道連續性與轉向軌跡，檢查路段如何銜接路口。",
      "defaultView": "single",
      "assets": [
        "m101-issue-junction",
        "m101-issue-road-section"
      ],
      "points": [
        {
          "id": "continuity",
          "title": "車道用途前後不連續",
          "text": "路段車道若未配合轉向需求，駕駛到路口前才會發現需要換道。",
          "focus": {
            "asset": "m101-issue-road-section"
          }
        },
        {
          "id": "path",
          "title": "導引線未配合實際軌跡",
          "text": "轉彎路徑若未檢核，車輛可能無法沿線行駛，甚至偏向交通島。",
          "focus": {
            "asset": "m101-issue-junction"
          }
        },
        {
          "id": "review",
          "title": "一併檢視路段與路口",
          "text": "從車道配置、轉向軌跡到下游出口，一起確認動線是否連續。",
          "focus": {
            "asset": "m101-issue-junction"
          }
        }
      ],
      "sourcePages": [],
      "references": [
        "133-1",
        "171",
        "183-1",
        "184",
        "188",
        "189",
        "189-1"
      ],
      "applicationNote": "通用模組，適用於各類道路情境。",
      "pointLinkedImages": true
    },
    {
      "id": "m101-lanes-diagram",
      "section": "module",
      "submoduleId": "M1-01.1",
      "title": "路口與路段車道配置｜圖例說明",
      "intro": "以標線與預告標誌，逐步說清楚各方向的車道與行進路徑。",
      "assets": [
        "m101-lanes"
      ],
      "points": [
        {
          "id": "advance-signs",
          "title": "預告車道用途與方向",
          "text": "於車道用途改變或轉向車道分流前，設置車道預告標誌與指向線，提示各車道的行駛方向。"
        },
        {
          "id": "advance-dotted",
          "title": "引導提前選道",
          "text": "配合穿越虛線標示轉向車道的分流範圍，引導車輛提前選擇適當車道。"
        },
        {
          "id": "advance-solid",
          "title": "減少臨時變換車道",
          "text": "接近路口處配合禁止變換車道線，減少臨時變換車道的情形。"
        },
        {
          "id": "connect-review",
          "title": "檢核前後車道銜接",
          "text": "依路口上下游車道數、車道用途與行駛方向，檢核各車道的銜接關係。"
        },
        {
          "id": "connect-transition",
          "title": "安排縮減與偏移",
          "text": "車道需要縮減或偏移時，應妥善安排車道配置及變換車道位置，避免車輛於路口內爭道。"
        },
        {
          "id": "connect-guides",
          "title": "標示穿越路徑",
          "text": "必要時利用路口行車導引線，明確標示穿越路口後的行駛路徑。"
        },
        {
          "id": "turn-review",
          "title": "檢核設計車輛軌跡",
          "text": "依設計車輛的轉彎軌跡，檢核路口行車導引線、路緣轉角及交通島配置。"
        },
        {
          "id": "turn-space",
          "title": "保留轉彎空間",
          "text": "避免轉彎空間不足，造成車輛偏離行駛路徑或擦撞交通島、路緣。"
        },
        {
          "id": "turn-curb",
          "title": "合理配置路緣轉角",
          "text": "避免路緣轉角僅採直線截角而形成不必要的車行空間，增加行人穿越距離。"
        }
      ],
      "sourcePages": [],
      "references": []
    },
    {
      "id": "m101-lanes-extensions",
      "section": "module",
      "submoduleId": "M1-01.1",
      "title": "慢車道與一般車道同寬",
      "intro": "在路口銜接處，讓車種分隔配合轉向需求。",
      "assets": [
        "m101-slow-wide"
      ],
      "points": [
        {
          "id": "right-turn",
          "title": "讓右轉車提早就位",
          "text": "慢車道較寬時，可延續快慢車道分隔線；右轉車依規定提前進入慢車道。"
        },
        {
          "id": "lane-line",
          "title": "必要時改以車道線提示",
          "text": "近路口處可將快慢車道分隔線改為車道線，提示右轉車先進入最外側車道。"
        }
      ],
      "sourcePages": [],
      "references": []
    },
    {
      "id": "m101-lanes-narrow",
      "section": "module",
      "submoduleId": "M1-01.1",
      "title": "窄慢車道銜接路口",
      "intro": "由車種分隔轉為方向分隔，減少路口前的交織。",
      "assets": [
        "m101-slow-narrow"
      ],
      "points": [
        {
          "id": "transition",
          "title": "2.8 m（含）以下先調整配置",
          "text": "在路口前 30–60 m 中斷慢車道配置，配合分流式指向線引導各方向車流。"
        },
        {
          "id": "width",
          "title": "過寬空間以槽化調整",
          "text": "非實體分隔的最外側車道不宜大於 4.5 m；原車道與慢車道合計過寬時，可用槽化縮減。"
        },
        {
          "id": "warning",
          "title": "車道縮減要提前提示",
          "text": "必要時加設車道、路寬縮減標誌，提醒慢車道車流向左銜接下游外側車道。"
        }
      ],
      "sourcePages": [],
      "references": []
    },
    {
      "id": "m101-additional-issues",
      "section": "module",
      "submoduleId": "M1-01.2",
      "title": "附加車道｜現況議題與相關條文",
      "intro": "附加車道除了要放得下，也要讓駕駛看得懂、來得及進入。",
      "assets": [
        "m101-additional-issue-missing",
        "m101-additional-issue-photo"
      ],
      "points": [
        {
          "id": "missing-lane",
          "title": "缺乏附加車道",
          "text": "原直行車道於路口前改為左轉車道，轉向車流未另設附加車道分流，影響直行動線的連續性。",
          "focus": {
            "asset": "m101-additional-issue-missing"
          }
        },
        {
          "id": "recognition",
          "title": "車道變化不易提早辨識",
          "text": "標線與預告不完整，駕駛可能到路口前才察覺轉向車道。",
          "focus": {
            "asset": "m101-additional-issue-photo"
          }
        },
        {
          "id": "storage",
          "title": "漸變或儲車空間不足",
          "text": "轉向車流無法順暢進入，排隊可能外溢並影響主線直行車流。",
          "focus": {
            "asset": "m101-additional-issue-photo"
          }
        },
        {
          "id": "consistency",
          "title": "幾何與導引一起檢視",
          "text": "同時確認漸變長度、儲車空間、車道連續性與標誌標線的一致性。",
          "focus": {
            "asset": "m101-additional-issue-photo"
          }
        }
      ],
      "sourcePages": [],
