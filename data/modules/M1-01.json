    {
      "id": "m101-additional-diagram",
      "section": "module",
      "submoduleId": "M1-01.2",
      "title": "附加車道｜圖例說明",
      "intro": "依轉向車流需求配置漸變與儲車空間，並透過標誌標線提前預告車道變化及引導分流。",
      "assets": [
        "m101-additional",
        "m101-taper"
      ],
      "points": [
        {
          "id": "taper-speed",
          "title": "依設計速率檢核漸變長度",
          "text": "依《市區道路及附屬工程設計規範》第 4.2.6 節，按設計速率及漸變段長寬比配置附加車道。"
        },
        {
          "id": "storage-space",
          "title": "依轉向車流需求配置儲車空間",
          "text": "檢核轉向車輛的排隊需求，避免儲車長度不足造成車流回堵至直行車道。"
        },
        {
          "id": "advance-signs",
          "title": "於漸變區上游預告車道配置",
          "text": "在漸變區前設置車道預告標誌，使駕駛人提前辨識轉向專用車道的位置。"
        },
        {
          "id": "entry-arrows",
          "title": "於漸變起點標示行駛方向",
          "text": "附加車道開始漸變處，配合左轉或右轉指向線，提示轉向車輛進入附加車道。"
        },
        {
          "id": "dotted-diversion",
          "title": "以穿越虛線引導轉向車流",
          "text": "穿越虛線自漸變區起點延伸至專用車道起點，標示轉向車輛進入附加車道的範圍。"
        },
        {
          "id": "lane-boundaries",
          "title": "配合禁止變換車道線及槽化線",
          "text": "路口前 20 m 配合禁止變換車道線；不供車輛通行的多餘空間，可利用槽化線界定並引導車流。"
        }
      ],
      "sourcePages": [],
      "references": [],
      "defaultView": "single"
    },
    {
      "id": "m101-additional-extensions",
      "section": "module",
      "submoduleId": "M1-01.2",
      "title": "附加車道搭配庇護島",
      "intro": "讓分流車道與行人穿越空間一起安排。",
      "assets": [
        "m101-refuge"
      ],
      "points": [
        {
          "id": "pedestrians",
          "title": "提供行人停等與避護空間",
          "text": "近路口處可設行人庇護島，讓行人穿越時有安全的停等位置。"
        },
        {
          "id": "guidance",
          "title": "以實體島頭引導車流",
          "text": "配合島頭及邊界，明確導引附加車道與主線的行進路徑。"
        }
      ],
