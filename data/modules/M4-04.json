    {
      "id": "m404-pedestrian-issues",
      "section": "module",
      "submoduleId": "M4-04.1",
      "title": "區域管制｜現況議題與相關條文",
      "intro": "行人優先區與通學區應依實際通行需求界定管制範圍，並透過完整的區域邊界及一致的交通管制設施，使駕駛人清楚辨識區域內的通行要求。",
      "assets": [
        "m404-pedestrian-issue-photo-1"
      ],
      "points": [
        {
          "id": "meaning",
          "title": "區域範圍與實際通行需求未能對應",
          "text": "行人優先區若僅設置標誌，未配合道路環境調整，可能使駕駛人難以辨識行人優先要求；通學區若僅以校門位置或固定距離界定，則可能未能完整涵蓋學童實際通行路徑。",
          "focus": {
            "asset": "m404-pedestrian-issue-photo-1"
          }
        },
        {
          "id": "boundary",
          "title": "區域邊界與管制資訊不明確",
          "text": "若各出入口未完整設置起終點標誌，或速限及適用時段資訊缺乏整合，可能使駕駛人難以判斷管制區域的適用範圍及應遵循的通行要求。",
          "focus": {
            "asset": "m404-pedestrian-issue-photo-1"
          }
        }
      ],
      "sourcePages": [],
      "references": [
        "67-2",
        "137-1",
        "163-1"
      ],
      "defaultView": "single",
      "imageFit": "contain",
      "pointLinkedImages": false
    },
    {
      "id": "m404-pedestrian-diagram",
      "section": "module",
      "submoduleId": "M4-04.1",
      "title": "區域管制｜圖例說明",
      "intro": "依行人優先及通學需求界定適當的區域範圍，並整合起終點標誌、標線與速限資訊，建立明確且連續的區域管制方式。",
      "assets": [
        "m404-3762916f50",
        "m404-8af799c9f9",
        "m404-f3708fbde3",
        "m404-271591fe84"
      ],
      "points": [
        {
          "id": "pedestrian",
          "title": "行人優先區應配合道路環境表達通行要求",
          "text": "行人優先區允許行人於道路全寬通行，車輛仍得進入，但須減速並停讓行人。區域內的車行空間、出入口及停車配置應配合調整，使道路環境與行人優先的通行原則一致。",
          "focus": {
            "asset": "m404-3762916f50"
          }
        },
        {
          "id": "school",
          "title": "通學區應涵蓋實際通學路徑",
          "text": "通學區不應僅以校門或固定距離界定，應考量住宅、公共運輸站點與學校之間的主要通學路徑，將學童經常通行的路口及路段納入管制範圍。",
          "focus": {
            "asset": "m404-8af799c9f9"
          }
        },
        {
          "id": "pair",
          "title": "完整配置區域起終點標誌",
          "text": "區域邊界上各進出方向均應配置相對應的起終點標誌，原則設於車行方向右側；區域內交叉口不再重複設置，避免駕駛人誤判區域範圍。",
          "focus": {
            "asset": "m404-3762916f50"
          }
        },
        {
          "id": "speed",
          "title": "整合區域管制與速限資訊",
          "text": "應配合區域通行需求設置最高速限標誌，建議與起終點標誌共桿配置，並將速限標誌設於上方，使駕駛人能同時辨識區域範圍及速率限制。",
          "focus": {
            "asset": "m404-3762916f50"
          }
        },
        {
          "id": "obstruction",
          "title": "避免終點標誌遮擋其他管制設施",
          "text": "終點標誌若可能遮擋停、讓等禁制標誌，可提前於路段上游設置，使兩者錯開，或調整至車行方向左側，確保管制資訊清楚可辨。",
          "focus": {
            "asset": "m404-3762916f50"
          }
        },
        {
          "id": "timing",
          "title": "配合通學區標線及時段資訊",
          "text": "通學區可配合起終點標線強化區域邊界辨識；有特定適用時段時，應清楚說明適用時間，使駕駛人正確判斷通學區的管制要求。",
          "focus": {
            "asset": "m404-f3708fbde3"
          }
        }
      ],
      "sourcePages": [],
      "references": [
        "67-2",
        "137-1",
        "163-1"
      ],
      "imageFit": "contain"
    },
    {
      "id": "m404-pedestrian-extensions",
      "section": "module",
      "submoduleId": "M4-04.1",
      "title": "與最高速限標誌整合",
      "intro": "從區域邊界、速限到道路環境，持續表達行人優先。",
      "assets": [
        "m404-3762916f50"
      ],
      "points": [
        {
          "id": "pole",
          "title": "共桿呈現區域與速限資訊",
          "text": "本指引建議共桿設置，最高速限標誌置於行人優先區起終點標誌上方。"
        },
        {
          "id": "environment",
          "title": "標誌與道路環境共同表達行人優先",
          "text": "配合出入口、車行空間及停車配置檢討，維持清楚連續的區域辨識。"
        }
      ],
      "sourcePages": [],
      "references": [
        "67-2"
      ]
    },
    {
      "id": "m404-school-issues",
      "section": "module",
      "submoduleId": "M4-04.2",
      "title": "通學區｜現況議題與相關條文",
      "intro": "依實際通學路徑界定區域，整合邊界、速限與必要時段資訊。",
      "assets": [
        "m404-8af799c9f9"
      ],
      "points": [
        {
          "id": "routes",
          "title": "通學需求不只在校門前",
          "text": "應檢視住宅、公共運輸站點與學校之間的實際通學路徑。"
        },
        {
          "id": "coverage",
          "title": "範圍、速限與時段需要配合",
          "text": "各入口與主要通學路口、路段若未完整涵蓋，駕駛難以判斷適用要求。"
        }
      ],
      "sourcePages": [],
      "references": [
        "137-1",
        "163-1"
      ]
    },
    {
      "id": "m404-school-diagram",
      "section": "module",
      "submoduleId": "M4-04.2",
      "title": "通學區｜圖例說明",
      "intro": "對照圖例，逐項檢視設施位置與配置方式。",
      "assets": [
        "m404-8af799c9f9",
        "m404-f3708fbde3"
      ],
      "points": [
        {
          "id": "boundary",
          "title": "依通學需求界定範圍",
          "text": "確認穿越區界的道路都設置起終點標誌；區內原則不重複設置。"
        },
        {
          "id": "side",
          "title": "起終點標誌原則設於右側",
          "text": "讓駕駛在各出入口都能辨識進入與離開通學區。"
        },
        {
          "id": "speed",
          "title": "速限標誌與通學區標誌共桿",
          "text": "配合設置時，建議最高速限標誌置於通學區標誌上方。"
        },
        {
          "id": "obstruction",
          "title": "終點標誌避免遮擋禁制標誌",
          "text": "有需要時提前錯開或移至左側，讓停讓資訊仍清楚可見。"
        }
      ],
      "sourcePages": [],
      "references": [
        "137-1",
        "163-1"
      ]
    },
    {
      "id": "m404-school-extensions",
      "section": "module",
      "submoduleId": "M4-04.2",
      "title": "通學區起終點標線",
      "intro": "依實際通學路徑界定區域，整合邊界、速限與必要時段資訊。",
      "assets": [
        "m404-271591fe84"
      ],
      "points": [
        {
          "id": "markings",
          "title": "標線與區域邊界相互對應",
          "text": "配合起終點標誌檢查位置，讓進入與離開通學區的資訊一致。"
        },
        {
          "id": "guidelines",
          "title": "依校園周邊人行空間指引檢討",
          "text": "其他配置原則及案例，參照交通部校園周邊人行空間改善參考指引。"
        }
      ],
      "sourcePages": [],
