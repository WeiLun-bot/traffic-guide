  "pages": [
    {
      "id": "m404-overview",
      "section": "overview",
      "title": "M4-04 區域管制",
      "intro": "以完整邊界與一致資訊，說明區域內的通行要求。",
      "assets": [
        "m404-3762916f50",
        "m404-8af799c9f9"
      ],
      "points": [
        {
          "id": "pedestrian",
          "title": "M4-04.1 行人優先區",
          "text": "讓起終點標誌、速限與道路環境持續表達行人優先。",
          "submoduleId": "M4-04.1"
        },
        {
          "id": "school",
          "title": "M4-04.2 通學區",
          "text": "依通學路徑安排區界標誌、標線與速限資訊。",
          "submoduleId": "M4-04.2"
        }
      ],
      "sourcePages": [],
      "references": []
    },
    {
      "id": "m404-pedestrian-issues",
      "section": "module",
      "submoduleId": "M4-04.1",
      "title": "行人優先區｜現況議題與相關條文",
      "intro": "從區域邊界、速限到道路環境，持續表達行人優先。",
      "assets": [
        "m404-3762916f50"
      ],
      "points": [
        {
          "id": "meaning",
          "title": "行人優先要求需持續可辨識",
          "text": "區內允許行人使用道路全寬，車輛可進入但須減速、停讓；道路環境也應反映此通行方式。"
        },
        {
          "id": "boundary",
          "title": "各方向入口需有一致資訊",
          "text": "若只加標誌而環境未調整，或不同入口標示不完整，容易對區域範圍產生不同理解。"
        }
      ],
      "sourcePages": [],
      "references": [
        "67-2"
      ]
    },
    {
      "id": "m404-pedestrian-diagram",
      "section": "module",
      "submoduleId": "M4-04.1",
      "title": "行人優先區｜圖例說明",
      "intro": "對照圖例，逐項檢視設施位置與配置方式。",
      "assets": [
        "m404-3762916f50"
      ],
      "points": [
        {
          "id": "pair",
          "title": "起點應有對應終點",
          "text": "起終點原則設於車行方向右側，區內交叉口不再重複設置。"
        },
        {
          "id": "obstruction",
          "title": "終點標誌避免遮擋停讓資訊",
          "text": "有遮擋可能時，可提前至路段上游錯開，或改設車行方向左側。"
        }
      ],
      "sourcePages": [],
      "references": [
        "67-2"
      ]
    },
    {
      "id": "m404-pedestrian-extensions",
      "section": "module",
      "submoduleId": "M4-04.1",
      "title": "與最高速限標誌整合",
      "intro": "從區域邊界、速限到道路環境，持續表達行人優先。",
      "assets": [
        "m404-3762916f50"
      ],
      "points": [
        {
          "id": "pole",
          "title": "共桿呈現區域與速限資訊",
          "text": "本指引建議共桿設置，最高速限標誌置於行人優先區起終點標誌上方。"
        },
        {
          "id": "environment",
          "title": "標誌與道路環境共同表達行人優先",
          "text": "配合出入口、車行空間及停車配置檢討，維持清楚連續的區域辨識。"
        }
      ],
      "sourcePages": [],
      "references": [
        "67-2"
      ]
    },
    {
      "id": "m404-school-issues",
      "section": "module",
      "submoduleId": "M4-04.2",
      "title": "通學區｜現況議題與相關條文",
      "intro": "依實際通學路徑界定區域，整合邊界、速限與必要時段資訊。",
      "assets": [
        "m404-8af799c9f9"
      ],
      "points": [
        {
          "id": "routes",
          "title": "通學需求不只在校門前",
          "text": "應檢視住宅、公共運輸站點與學校之間的實際通學路徑。"
        },
        {
          "id": "coverage",
          "title": "範圍、速限與時段需要配合",
          "text": "各入口與主要通學路口、路段若未完整涵蓋，駕駛難以判斷適用要求。"
        }
      ],
      "sourcePages": [],
      "references": [
        "137-1",
        "163-1"
      ]
    },
    {
      "id": "m404-school-diagram",
      "section": "module",
      "submoduleId": "M4-04.2",
      "title": "通學區｜圖例說明",
      "intro": "對照圖例，逐項檢視設施位置與配置方式。",
      "assets": [
        "m404-8af799c9f9",
        "m404-f3708fbde3"
      ],
      "points": [
        {
          "id": "boundary",
          "title": "依通學需求界定範圍",
          "text": "確認穿越區界的道路都設置起終點標誌；區內原則不重複設置。"
        },
        {
          "id": "side",
          "title": "起終點標誌原則設於右側",
          "text": "讓駕駛在各出入口都能辨識進入與離開通學區。"
        },
        {
          "id": "speed",
          "title": "速限標誌與通學區標誌共桿",
          "text": "配合設置時，建議最高速限標誌置於通學區標誌上方。"
        },
        {
          "id": "obstruction",
          "title": "終點標誌避免遮擋禁制標誌",
          "text": "有需要時提前錯開或移至左側，讓停讓資訊仍清楚可見。"
        }
      ],
      "sourcePages": [],
      "references": [
        "137-1",
        "163-1"
      ]
    },
    {
      "id": "m404-school-extensions",
      "section": "module",
      "submoduleId": "M4-04.2",
      "title": "通學區起終點標線",
      "intro": "依實際通學路徑界定區域，整合邊界、速限與必要時段資訊。",
      "assets": [
        "m404-271591fe84"
      ],
      "points": [
        {
          "id": "markings",
          "title": "標線與區域邊界相互對應",
          "text": "配合起終點標誌檢查位置，讓進入與離開通學區的資訊一致。"
        },
        {
          "id": "guidelines",
          "title": "依校園周邊人行空間指引檢討",
          "text": "其他配置原則及案例，參照交通部校園周邊人行空間改善參考指引。"
        }
      ],
      "sourcePages": [],
      "references": [
        "137-1",
        "163-1"
      ]
    }
  ],
